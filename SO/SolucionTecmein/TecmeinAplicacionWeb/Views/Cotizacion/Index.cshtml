 @{
     ViewData["Title"] = "Cotizaciones";
     Layout = "~/Views/Shared/_Layout.cshtml";
 }
 
 @section Estilos {
     <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
     <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
     <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
     <link rel="stylesheet" href="~/css/styleGenerales.css">
     <style>
         .bg-pale-blue {
             background-color: #e0f2f7 !important; /* A light blue color */
         }
         #tbDetalles th:nth-child(3),
         #tbDetalles td:nth-child(3),
         #tbDetalles th:nth-child(4),
         #tbDetalles td:nth-child(4),
         #tbDetalles th:nth-child(5),
         #tbDetalles td:nth-child(5) {
             min-width: 70px;
         }

        #tbDetalles th, #tbDetalles td {
            font-size: 0.8rem; /* Ajusta este valor si es necesario */
            vertical-align: middle;
        }
     </style>
 }
 
 <!-- Grilla inicial de proceso -->
                                             <div class="card shadow-sm mb-1">     <div class="card-header py-3 bg-second-primary">
         <h6 class="m-0 font-weight-bold text-white">Lista de Cotizaciones</h6>
     </div>
     <div class="card-body">
         <div class="row">
             <div class="col-sm-3">
                 <button class="btn btn-success" id="btnNuevo" data-toggle="modal" data-target="#modalData">
                     <i class="fas fa-plus-circle"></i> Nueva Cotización
                 </button>
             </div>
         </div>
         <hr />
         <div class="row">
             <div class="col-sm-12">
                 <table class="table table-bordered" id="tbdata" cellspacing="0" style="width:100%">
                     <thead>
                         <tr>
                             <th>Id</th>
                             <th>Obra</th>
                             <th>Cliente</th>
                             <th>Enviado Proveedor</th>
                             <th>Enviado Cliente</th>
                             <th>Confirmado</th>
                             <th>Usuario</th>
                             <th>Último Editor</th>
                             <th>Estado</th>
                             <th>Acciones</th>
                         </tr>
                     </thead>
                     <tbody>
                     </tbody>
                 </table>
             </div>
         </div>
     </div>
 </div>
 
 <!-- Modal de Detalle/Edición -->
 <div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
     <div class="modal-dialog modal-xl" role="document">
         <div class="modal-content">
             <div class="card shadow-sm">
                 <div class="card-header py-2 bg-second-primary">
                     <h6 class="m-0 font-weight-bold text-white">
                         <i class="fas fa-file-signature"></i> Detalle Cotización
                         <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                             <span aria-hidden="true" class="text-white">×</span>
                         </button>
                     </h6>
                 </div>
                 <div class="card-body p-2">
                     <form>
                         <input type="hidden" value="0" id="txtId">
                        <div class="row">
                            <!-- Combined Visit Details Card -->
                            <div class="col-sm-12">
                                <div class="card shadow-sm mb-3">
                                    <div class="card-header py-2 bg-second-primary">
                                        <a href="#collapseGeneralInfo" class="d-block card-header-link text-white" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseGeneralInfo">
                                            <h6 class="m-0 font-weight-bold text-white">
                                                <i class="fas fa-info-circle"></i> Información General del Equipo
                                                <i class="fas fa-chevron-down float-right"></i>
                                            </h6>
                                        </a>
                                </div>

                                    <div class="collapse show" id="collapseGeneralInfo">
                                        <div class="card-body py-0">
                                            <div class="form-row">
                                                <div class="form-group col-sm-6 mb-2">
                                                    <label for="cboVisita" class="text-xs">Seleccionar Visita</label>
                                                    <select id="cboVisita" class="form-control form-control-sm text-xs"></select>
                                                </div>
                                                <div class="form-group col-sm-6 mb-2">
                                                    <label class="text-xs">Nombre de la Obra</label>
                                                    <input type="text" id="txtNombreObra" class="form-control form-control-sm text-xs" readonly>
                                                </div>
                                            </div>
                                            <div class="card py-0 shadow-sm mb-3">
                                                <div class="card-header py-sm-1 bg-second-primary">
                                                    <a href="#collapseDetailedInfo" class="d-block card-header-link text-white" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseDetailedInfo">
                                                        <h6 class="m-0 font-weight-bold text-white">
                                                            <i class="fas fa-info-circle"></i> Detalles de la Visita y Contacto
                                                            <i class="fas fa-chevron-down float-right"></i>
                                                        </h6>
                                                    </a>
                                                </div>
                                                <div class="collapse show" id="collapseDetailedInfo">
                                                   @*  <div class="card-body p-sm-3"> *@
                                                        <!-- Detailed Visit Info (rearranged) -->
                                                    <div class="form-row py-sm-1" id="visitDetailsContent" style="display:none;">
                                                            <div class="col-sm-3 mb-0 text-xs"><strong class="d-inline-block mr-1">Provincia:</strong><span id="pProvincia"></span></div>
                                                            <div class="col-sm-3 mb-0 text-xs"><strong class="d-inline-block mr-1">Cantón:</strong><span id="pCanton"></span></div>
                                                            <div class="col-sm-3 mb-0 text-xs"><strong class="d-inline-block mr-1">Parroquia:</strong><span id="pParroquia"></span></div>
                                                       @*  </div>
                                                        <div class ="form-row" id="contactDetailsContent" style="display:none;">*@
                                                            <div class="col-sm-3 mb-0 text-xs"><strong class="d-inline-block mr-1">Constructora:</strong><span id="pConstructora"></span></div>
                                                            <div class="col-sm-3 mb-0 text-xs"><strong class="d-inline-block mr-1">Contacto:</strong><span id="pContacto"></span></div>
                                                            <div class="col-sm-3 mb-0 text-xs"><strong class="d-inline-block mr-1">Correo:</strong><span id="pCorreoContacto"></span></div>
                                                            <div class="col-sm-3 mb-0 text-xs"><strong class="d-inline-block mr-1">Teléfono:</strong><span id="pTelefonoContacto"></span></div>
                                                            @* </div>
                                                        <div class="form-row" id="userGeneratorContent" style="display:none;">
                                                            *@
                                                            <div class="col-sm-3 mb-0 text-xs"><strong class="d-inline-block mr-1">Usuario Visita:</strong><span id="pUsuarioGenerador"></span></div>
                                                            <div class="col-sm-3 mb-0 text-xs"><strong class="d-inline-block mr-1">Usuario Cotizador:</strong><span id="pUsuarioCotizador"></span></div>
                                                            <div class="col-sm-3 mb-0 text-xs"></div>
                                                            <div class="col-sm-3 mb-0 text-xs"></div>
                                                            <div class="col-sm-12 mb-0 text-xs"><strong class="d-inline-block mr-1">Dirección:</strong><span id="pDireccionProyecto"></span></div>
                                                        </div>
                                                    @* </div> *@
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sección de Detalles de la Cotización -->
                            <div class="col-sm-12">
                                <div class="card shadow-sm">
                                    <div class="card-header py-2 bg-second-primary">
                                        <h6 class="m-0 font-weight-bold text-white"><i class="fas fa-list-ul"></i> Detalles de la Cotización</h6>
                                    </div>
                                    <div class="card-body">
                                        <table class="table table-sm table-bordered" id="tbDetalles">
                                            <thead class="bg-pale-blue text-dark">
                                                <tr>
                                                    <th class="text-xs">Detalle Equipo</th>
                                                    <th class="text-xs">Cant</th>
                                                    <th class="text-xs">Valor Compra</th>
                                                    <th class="text-xs">Margen (%)</th>
                                                    <th class="text-xs">Total</th>
                                                    <th class="text-xs"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <!-- Filas de detalles se agregarán dinámicamente -->
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="card-footer">
                                        <div class="row">
                                            <div class="col-sm-6 bg-light p-2">
                                                <div class="row align-items-center">
                                                    <div class="col-sm-6">
                                                        <button class="btn btn-info btn-block btn-sm" type="button" id="btnGenerarPdf">
                                                            <i class="fas fa-file-pdf"></i> PDF Proveedor
                                                        </button>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" value="" id="chkEnviadoProveedor">
                                                            <label class="form-check-label text-xs" for="chkEnviadoProveedor">
                                                                Enviado a Proveedor
                                                            </label>
                                                        </div>
                                                    </div>
                                                    <div class="col-sm-6 mt-2">
                                                        <span class="d-inline-block btn-block" tabindex="0" data-toggle="tooltip" title="">
                                                            <button class="btn btn-success btn-block btn-sm" type="button" id="btnGenerarPdfCliente">
                                                                <i class="fas fa-file-pdf"></i> PDF Cliente
                                                            </button>
                                                        </span>
                                                    </div>
                                                    <div class="col-sm-6 mt-2">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" value="" id="chkEnviadoCliente">
                                                            <label class="form-check-label text-xs" for="chkEnviadoCliente">
                                                                Enviado al Cliente
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-sm-6 text-right p-2">
                                                <strong>Subtotal: </strong><span id="spanSubtotal">0.00</span>
                                                <div id="divImpuestosDetalle"></div> <!-- Contenedor para el desglose dinámico de impuestos -->
                                                <br>
                                                <strong>Total Impuestos: </strong><span id="spanImpuestos">0.00</span>
                                                <br>
                                                <strong>Total: </strong><span id="spanTotal">0.00</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            
                        </div>
                     </form>
                 </div>
                 <div class="card-body p-0 d-flex justify-content-end">
                     <button class="btn btn-primary btn-sm m-1 mr-2" type="button" id="btnGuardar">Guardar</button>
                     <button class="btn btn-danger btn-sm m-1" type="button" data-dismiss="modal">Cancelar</button>
                 </div>
             </div>
         </div>
     </div>
 </div>
 
<!-- Modal de Seguimiento -->
<div class="modal fade" id="modalSeguimiento" tabindex="-1" role="dialog" aria-labelledby="modalSeguimientoLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="card shadow-sm">
                <div class="card-header py-2 bg-second-primary">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-history"></i> Historial de Seguimiento
                        <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" class="text-white">×</span>
                        </button>
                    </h6>
                </div>
                <div class="card-body p-2">
                    <input type="hidden" id="hiddenCotizacionId" value="0" />
                    <button id="btnNuevoSeguimiento" class="btn btn-sm btn-success mb-2">Nuevo Seguimiento</button>
                    <table id="tbSeguimiento" class="table table-striped table-bordered" style="width:100%">
                        <thead>
                            <tr>
                                <th>Acción</th>
                                <th>Detalle</th>
                                <th>Fecha Acción</th>
                                <th>Aceptado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear/Editar Seguimiento -->
<div class="modal fade" id="modalDataSeguimiento" tabindex="-1" role="dialog" aria-labelledby="modalDataSeguimientoLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="card shadow-sm">
                <div class="card-header py-2 bg-second-primary">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-clipboard-list"></i> Detalle de Seguimiento
                        <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" class="text-white">×</span>
                        </button>
                    </h6>
                </div>
                <div class="card-body p-2">
                    <form id="formSeguimiento">
                        <input type="hidden" id="txtIdSeguimiento" value="0">
                        <div class="form-group">
                            <label for="txtAccion">Acción</label>
                            <input type="text" class="form-control" id="txtAccion" placeholder="Ej: Llamada, Correo, Reunión">
                        </div>
                        <div class="form-group">
                            <label for="txtDetalle">Detalle</label>
                            <textarea class="form-control" id="txtDetalle" rows="4"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="txtFechaAccion">Fecha de Acción</label>
                            <input type="date" class="form-control" id="txtFechaAccion">
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkAceptacionCliente">
                            <label class="form-check-label" for="chkAceptacionCliente">
                                Aceptación del Cliente (Convierte a Pre-Contrato)
                            </label>
                        </div>
                    </form>
                </div>
                <div class="card-body p-0 d-flex justify-content-end">
                    <button type="button" class="btn btn-primary btn-sm m-1 mr-2" id="btnGuardarSeguimiento">Guardar</button>
                    <button type="button" class="btn btn-danger btn-sm m-1" data-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>


 <!-- Modal para Editor de Pre-Contrato -->
<div class="modal fade" id="modalPreContratoEditor" tabindex="-1" role="dialog" aria-labelledby="modalPreContratoEditorLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalPreContratoEditorLabel">Editor de Pre-Contrato</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <textarea id="txtPreContratoEditor"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarPreContratoVersion">Guardar Versión</button>
            </div>
        </div>
    </div>
</div>


 @section Scripts {
     <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
     <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
     <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <!-- jsPDF y autoTable -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.23/jspdf.plugin.autotable.min.js"></script>
     <script src="~/js/vistas/Cotizacion_Index.js"></script>
 }
