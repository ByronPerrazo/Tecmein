@model TecmeinWebApp.Models.ViewModel.PlantillaPreContratoVM

@{ 
    ViewData["Title"] = "Plantillas de Pre-Contrato";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5>Gestión de Plantillas de Pre-Contrato</h5>
    </div>
    <div class="card-body">
        <form id="plantillaForm">
            <input type="hidden" asp-for="SecPlantillaPreContrato" />

            <div class="form-group">
                <label for="Nombre">Nombre de la Plantilla</label>
                <input type="text" class="form-control" asp-for="Nombre" placeholder="Ej: Plantilla General">
            </div>

            <div class="form-group">
                <label for="NumeracionInicial">Numeración Inicial</label>
                <input type="text" class="form-control" asp-for="NumeracionInicial" placeholder="Ej: PC-001">
            </div>

            <div class="form-group">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="EstaActivo">
                    <label class="form-check-label" for="EstaActivo">
                        Está Activo
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Guardar Plantilla</button>
        </form>
    </div>
</div>

@section Scripts{
    <script src="~/js/vistas/PlantillaPreContrato_Index.js"></script>
}
