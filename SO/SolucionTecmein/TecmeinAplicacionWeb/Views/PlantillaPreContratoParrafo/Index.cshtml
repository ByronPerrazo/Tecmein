@model  TecmeinAplicacionWeb.Models.ViewModels.PlantillaPreContratoParrafoVM

@{ 
    ViewData["Title"] = "Párrafos de Plantilla de Pre-Contrato";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/styleGenerales.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/premium-design.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme-overrides.css" asp-append-version="true">
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-paragraph text-warning mr-1"></i> Gestión de Párrafo de Plantilla
        </h6>
    </div>
    <div class="card-body pt-3">
        <form id="parrafoForm">
            <input type="hidden" asp-for="SecPlantillaPreContratoParrafo" />
            <input type="hidden" asp-for="SecPlantillaPreContrato" />

            <div class="form-row">
                <div class="form-group col-md-3">
                    <label for="Orden" class="font-weight-bold">Orden / Secuencia</label>
                    <input type="number" class="form-control form-control-sm" asp-for="Orden">
                </div>
                <div class="form-group col-md-9 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" asp-for="EstaActivo">
                        <label class="form-check-label font-weight-bold" for="EstaActivo">
                            ¿Está Activo?
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-row mt-2">
                <div class="form-group col-md-12">
                    <label for="Contenido" class="font-weight-bold">Contenido del Párrafo</label>
                    <textarea class="form-control form-control-sm" asp-for="Contenido" rows="8" placeholder="Escriba aquí el contenido del párrafo..."></textarea>
                </div>
            </div>

            <div class="form-row mt-3">
                <div class="col-md-12 text-right">
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill mr-1"><i class="fas fa-save mr-1"></i> Guardar Párrafo</button>
                    <a href="/PlantillaPreContrato/Parrafos?secuencial=@Model.SecPlantillaPreContrato" class="btn btn-secondary btn-sm rounded-pill"><i class="fas fa-arrow-left mr-1"></i> Volver a la Lista</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts{
    <script src="~/js/vistas/PlantillaPreContratoParrafo_Index.js" asp-append-version="true"></script>
}

