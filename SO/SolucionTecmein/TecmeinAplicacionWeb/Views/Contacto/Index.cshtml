@{
    ViewData["Title"] = "Contacto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/modern-table.css">
}


<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Listado de Contactos</h6>
    </div>
    <div class="card-body pt-1">
        <div class="row">
            <div class="col-sm-3">
                <button class="btn btn-success" id="btnNuevoContacto" data-toggle="modal" data-target="#modalData">
                    <i class="fas fa-plus-circle"></i> Nuevo Contacto
                </button>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-12">
                <table class="table-modern" id="tbdata" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Constructora</th>
                            <th>Prof</th>
                            <th>Nombre</th>
                            <th>Apellidos</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<!--  Modal-->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="card shadow-sm">
                <div class="card-header py-2 bg-second-primary">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-id-card"></i> Detalle Contacto
                        <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" class="text-white">×</span>
                        </button>
                    </h6>
                </div>
                <div class="card-body p-2">
                    <form>
                        <input type="hidden" value="0" id="txtId">
                        <div class="row">
                            <div class="col-sm-12 text-xs">

                                <div class="form-row">
                                    <div class="form-group col-sm-12">
                                        <i class="cab_i_sm">Constructora</i>
                                        <select class="form-control form-control-sm " 
                                                id="cboEmpresa"
                                                name="Constructora">
                                        </select>
                                    </div>
                                </div>

                                <div class="form-row">

                                    <div class="form-group col-sm-2 ">
                                        <label for="cboAbreviatura">Profesión</label>
                                        <select class="form-control form-control-sm " 
                                                id="cboAbreviatura"
                                                name="Abreviatura">
                                            <option value="Sr">Sr/a.</option>
                                            <option value="Ing">Ing</option>
                                            <option value="Arq">Arq</option>
                                            <option value="Dr">Dr/a</option>
                                            <option value="ND">ND</option>
                                        </select>
                                    </div>

                                    <div class="form-group col-sm-5 text-xs">
                                        <label for="txtNombres">Nombres</label>
                                        <input type="text" 
                                            class="form-control form-control-sm input-validar" 
                                            id="txtNombres" name="Numero Documento">
                                    </div>


                                    <div class="form-group col-sm-5 text-xs">
                                        <label for="txtApellidos">Apellidos</label>
                                        <input type="text" 
                                               class="form-control form-control-sm input-validar" 
                                               id="txtApellidos" 
                                               name="Apellidos">
                                    </div>
                                </div>
                               
                                <div class="form-row">
                                    <div class="form-group col-sm-7">
                                        <label for="txtCorreo">Correo</label>
                                        <input type="email" 
                                            class="form-control form-control-sm input-validar" 
                                            id="txtCorreo" name="Correo">
                                    </div>
                                    <div class="form-group col-sm-5">
                                        <label for="txTelefono">Telefono</label>
                                        <input type="text" 
                                            class="form-control form-control-sm input-validar" 
                                            id="txTelefono" name="Telefono">
                                    </div>

                                </div>
                                <div class="form-row">
                                    <div class="form-group col-sm-6">
                                        <label for="cboEstado">Estado</label>
                                        <select class="form-control form-control-sm text-xs" 
                                                id="cboEstado">
                                            <option value="1">Activo</option>
                                            <option value="0">Inactivo</option>
                                        </select>
                                    </div>

                                </div>
                               
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-body p-0 d-flex justify-content-end">
                    <button class="btn btn-primary btn-sm m-1 mr-2" type="button" id="btnGuardarContacto">Guardar</button>
                    <button class="btn btn-danger btn-sm m-1" type="button" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>




@section Scripts {

    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>

    <script src="~/js/vistas/Contacto_Index.js"></script>

}
