@{
    ViewData["Title"] = "Rol";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/styleGenerales.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/premium-design.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/modern-table.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme-overrides.css" asp-append-version="true">
}

<div class="card shadow-sm mb-2">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Lista de Roles</h6>
    </div>
    <div class="card-body pt-1">
        <div class="row mb-3" style="display:none;">
            <div class="col-sm-12">
                <button class="btn btn-primary" id="btnNuevo" data-toggle="modal" data-target="#modalData">
                    <i class="fas fa-plus-circle"></i>
                    Nuevo Rol
                </button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <table class="table-modern" id="tbdata" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Descripcion</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

 <!--  Modal-->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-premium">
            <div class="modal-header-premium header-primary">
                <h6 class="modal-title">
                    <i class="fas fa-user-tag"></i> Detalle Rol
                </h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body p-3">
                <form>
                    <input type="hidden" value="0" id="txtId">
                    <div class="row">
                        <div class="col-sm-12">

                            <div class="form-row">
                                <div class="form-group col-sm-12">
                                    <label for="txtDescripcionRol">Descripción Rol</label>
                                    <input type="text" class="form-control form-control-sm input-validar" id="txtDescripcionRol" name="Razon Social">
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-sm-12">
                                    <label>Permisos</label>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-sm-4">
                                    <label for="checkConsultar">Consultar  </label>
                                    <input type="checkbox" class="custom-checkbox.small" id="checkConsultar">
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="checkModificar">Modificar  </label>
                                    <input type="checkbox" class="custom-checkbox.small" id="checkModificar">
                                </div>
                                <div class="form-group col-sm-4">
                                    <label for="checkEliminar">Eliminar  </label>
                                    <input type="checkbox" class="custom-checkbox.small" id="checkEliminar">
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-sm-6">
                                    <label for="cboEstado">Estado</label>
                                    <select class="form-control form-control-sm" id="cboEstado">
                                        <option value="1">Activo</option>
                                        <option value="0">Inactivo</option>
                                    </select>
                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 p-2">
                <button class="btn btn-primary btn-sm" type="button" id="btnGuardar">Guardar</button>
                <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>
    </div>
</div>



 
@section Scripts {

    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>


    <script src="~/js/vistas/Rol_Index.js" asp-append-version="true"></script>

}
