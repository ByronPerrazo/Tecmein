@model TecmeinAplicacionWeb.Models.ViewModels.GestionRolMenuVM

@{
    ViewData["Title"] = "Gestionar Permisos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/styleGenerales.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/premium-design.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/modern-table.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme-overrides.css" asp-append-version="true">
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-key text-warning mr-1"></i> Gestionar Permisos para Rol: @Model.NombreRol
        </h6>
    </div>
    <div class="card-body">
        <input type="hidden" id="secRol" value="@Model.SecRol" />
        <input type="hidden" id="nombreRol" value="@Model.NombreRol" />
        <div class="row">
            <div class="col-sm-12">
                <div id="menuTreeContainer"></div>
            </div>
        </div>
        <hr />
        <div class="text-right">
            <button class="btn btn-primary btn-sm rounded-pill mr-1" id="btnGuardarPermisos"><i class="fas fa-save mr-1"></i> Guardar Permisos</button>
            <a href="/Rol/Index" class="btn btn-secondary btn-sm rounded-pill"><i class="fas fa-arrow-left mr-1"></i> Volver a la Lista</a>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/vistas/gestionar_permisos.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            const rawMenusData = @Html.Raw(Json.Serialize(Model.Menus));
            console.log("Raw Menus Data:", rawMenusData);

            const menusData = rawMenusData && rawMenusData.$values ? rawMenusData.$values : rawMenusData;
            console.log("Processed Menus Data:", menusData);

            if (Array.isArray(menusData)) {
                renderMenuTree(menusData, $('#menuTreeContainer'));
            } else {
                console.error("menusData no es un array después de procesar. No se puede renderizar el árbol de menús.", menusData);
                $('#menuTreeContainer').html('<p>No se pudieron cargar los menús para este rol.</p>');
            }

            $('#btnGuardarPermisos').on('click', function () {
                const secRol = $('#secRol').val();
                const nombreRol = $('#nombreRol').val();
                const modelo = collectPermissions(parseInt(secRol), nombreRol);
                
                // Muestra un overlay de carga
                $("div.card").LoadingOverlay("show");

                fetch("/Rol/GuardarPermisos", {
                    method: "POST",
                    headers: {
                        'Content-Type': 'application/json;charset=utf-8'
                    },
                    body: JSON.stringify(modelo)
                })
                .then(response => {
                    $("div.card").LoadingOverlay("hide");
                    return response.ok ? response.json() : Promise.reject(response);
                })
                .then(responseJson => {
                    if (responseJson.estado) {
                        Swal.fire("¡Listo!", "Los permisos se han actualizado correctamente", "success").then(() => {
                            window.location.href = "/Rol/Index";
                        });
                    } else {
                        Swal.fire("Error", responseJson.mensajes, "error");
                    }
                })
                .catch(error => {
                    $("div.card").LoadingOverlay("hide");
                    Swal.fire("Error", "No se pudo comunicar con el servidor", "error");
                    console.error("Error en la solicitud fetch:", error);
                });
            });
        });
    </script>
}