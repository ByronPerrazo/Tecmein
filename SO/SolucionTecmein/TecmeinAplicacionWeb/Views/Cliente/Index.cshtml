@{
    ViewData["Title"] = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/styleGenerales.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/premium-design.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/modern-table.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme-overrides.css" asp-append-version="true">
}

<div class="card shadow-sm mb-2">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Lista de Clientes</h6>
    </div>
    <div class="card-body pt-1">
        <div class="row mb-3" style="display:none;">
            <div class="col-sm-12">
                <button class="btn btn-primary" id="btnNuevoCliente">
                    <i class="fas fa-plus-circle"></i>
                    <span class="d-none d-sm-inline">Nuevo Cliente</span>
                    <span class="d-inline d-sm-none">Nuevo</span>
                </button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <table id="tbdataClientes" class="table-modern" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Número Cliente</th>
                            <th>Nombre Constructora</th>
                            <th>Fecha Creación</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear/Editar Cliente -->
<div class="modal fade" id="modalCliente" tabindex="-1" role="dialog" aria-labelledby="modalClienteLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-premium">
            <div class="modal-header-premium header-primary">
                <h6 class="modal-title">
                    <i class="fas fa-user"></i> Detalle del Cliente
                </h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body p-3">
                <form id="formCliente">
                    <div class="form-section-premium mb-0">
                        <input type="hidden" id="txtSecCliente" value="0" />
                        <div class="form-group">
                            <label class="cab_i_sm" for="cboConstructoraCliente">Constructora</label>
                            <select class="form-control-premium w-100" id="cboConstructoraCliente"></select>
                        </div>
                        <div class="form-group">
                            <label class="cab_i_sm" for="txtNumeroCliente">Número de Cliente</label>
                            <input type="text" class="form-control-premium w-100" id="txtNumeroCliente" readonly>
                        </div>
                        <div class="form-group mt-3 d-flex align-items-center">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="chkEstaActivo" checked>
                                <label class="custom-control-label cab_i_sm" for="chkEstaActivo">Activo</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 p-2">
                <button class="btn btn-primary btn-sm" type="button" id="btnGuardarCliente"><i class="fas fa-save"></i> Guardar</button>
                <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/js/vistas/Cliente_Index.js" asp-append-version="true"></script>
}