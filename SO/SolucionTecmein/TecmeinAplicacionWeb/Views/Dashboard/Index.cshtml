
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Estilos {
   
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">

    <!-- Custom styles for this template-->
    <link href="~/css/sb-admin-2.css" rel="stylesheet">
}

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
    </div>

    <!-- Content Row -->
    <div class="row">

        <!-- Total de Contratos -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total de Contratos
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="totalContratos">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-file-contract fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ingresos Mensuales -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Ingresos Mensuales
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="ingresosMensuales">$0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagos Vencidos -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Pagos Vencidos
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="pagosVencidos">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-times fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nuevos Clientes (Último Mes) -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Nuevos Clientes (Último Mes)
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="nuevosClientes">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-plus fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MCP Section -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow mb-4">
                <a href="#mcpCollapseContent" class="d-block card-header py-3 bg-second-primary" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="mcpCollapseContent">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-robot"></i> Asistente Tecmein (MCP)
                    </h6>
                </a>
                <div class="input-group p-3 pt-0"> <!-- Input visible siempre, con padding para estética -->
                    <input type="text" id="mcpQueryInput" class="form-control" placeholder="Escribe tu consulta o usa el micrófono..." aria-label="Consulta para el asistente" aria-describedby="mcpSendButton">
                    <div class="input-group-append">
                        <button class="btn btn-primary" type="button" id="mcpVoiceInputButton"><i class="fas fa-microphone"></i></button>
                        <button class="btn btn-success" type="button" id="mcpSendButton"><i class="fas fa-paper-plane"></i> Enviar</button>
                    </div>
                </div>
                <div class="collapse" id="mcpCollapseContent"> <!-- Contenido colapsable, inicialmente oculto -->
                    <div class="card-body d-flex flex-column border rounded-bottom" style="height: 350px; background-color: #DAEBF5;"> <!-- Ajustar altura y rounded para que solo la parte inferior sea redondeada -->
                        <div id="mcpResponseArea" class="p-1 flex-grow-1 overflow-auto" style="overflow-y: auto;">
                            <!-- Las respuestas del MCP se mostrarán aquí -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row for Charts -->
    <div class="row mt-4">

        <!-- Area Chart - Ventas de los ultimos 7 días -->
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4">
                <!-- Card Header - Dropdown -->
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Ventas de los últimos 7 días</h6>
                </div>
                <!-- Card Body -->
                <div class="card-body">
                    <div class="chart-area">
                        <canvas id="charVentas"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pie Chart - Marcas Más Vendidas -->
        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4">
                <!-- Card Header - Dropdown -->
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Marcas Más Vendidas</h6>
                </div>
                <!-- Card Body -->
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="charProductos"></canvas>
                    </div>
                    <div class="mt-4 text-center small">
                        <span class="mr-2"><i class="fas fa-circle text-primary"></i> Direct</span>
                        <span class="mr-2"><i class="fas fa-circle text-success"></i> Social</span>
                        <span class="mr-2"><i class="fas fa-circle text-info"></i> Referral</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Pie Chart - Visitas por Etapa -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Visitas por Etapa</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4 pb-2">
                        <canvas id="chartVisitasPorEtapa"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bar Chart - Contratos por Mes -->
        <div class="col-xl-6 col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Contratos por Mes</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="chartContratosPorMes"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Horizontal Bar Chart - Top 5 Clientes -->
        <div class="col-xl-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top 5 Clientes con más Contratos</h6>
                </div>
                <div class="card-body">
                    <div class="chart-bar">
                        <canvas id="chartTopClientes"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>



@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
    <script>console.log('Chart.js loaded:', typeof Chart);</script>
    <script src="~/js/vistas/DashBoard_Index.js"></script>
}
