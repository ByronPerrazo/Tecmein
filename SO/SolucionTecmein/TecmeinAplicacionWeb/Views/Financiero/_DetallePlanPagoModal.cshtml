@model TecmeinAplicacionWeb.Models.ViewModels.DetallePlanPagoVM

<div class="modal fade" id="detallePlanPagoModal" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content modal-content-premium">
            <div class="modal-header-premium header-primary">
                <h6 class="modal-title">
                    <i class="fas fa-file-invoice-dollar"></i> Detalle del Plan de Pago
                </h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body p-3">
                    <div class="row mb-3 d-flex">
                        <!-- Card: Información del Contrato -->
                        <div class="col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-header py-2">
                                    <h6 class="m-0 font-weight-bold text-primary">Información del Contrato</h6>
                                </div>
                                <div class="card-body p-0">
                                    <ul class="list-group list-group-flush">
                                      <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <strong>No. Contrato:</strong>
                                            <span id="modalNumeroContrato" class="badge badge-primary badge-pill">@Model?.NumeroContrato</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <strong>Cliente:</strong>
                                            <span id="modalNombreCliente" class="text-right">@Model?.NombreCliente</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <strong>Proyecto:</strong>
                                            <span id="modalNombreProyecto" class="text-right">@Model?.NombreProyecto</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Card: Resumen Financiero -->
                        <div class="col-md-6">
                            <div class="card shadow-sm h-100">
                                <div class="card-header py-2">
                                    <h6 class="m-0 font-weight-bold text-primary">Resumen Financiero</h6>
                                </div>
                                <div class="card-body p-0">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center bg-success text-white">
                                            <strong>Monto Pagado:</strong>
                                            <span id="modalMontoPagadoTotal">@Model?.MontoPagadoTotal.ToString("C")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center bg-danger text-white">
                                            <strong>Saldo Vencido:</strong>
                                            <span id="modalSaldoVencidoTotal">@Model?.SaldoVencidoTotal.ToString("C")</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center bg-warning text-dark">
                                            <strong>Saldo Pendiente:</strong>
                                            <span id="modalSaldoPendienteTotal">@Model?.SaldoPendienteTotal.ToString("C")</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <!-- Card: Detalles del Plan de Pagos -->
                        <div class="col-12">
                            <div class="card shadow-sm">
                                <div class="card-header py-2">
                                    <h6 class="m-0 font-weight-bold text-primary">Detalles del Plan</h6>
                                </div>
                                <div class="card-body p-0">
                                    <ul class="list-group list-group-flush list-group-horizontal-md flex-wrap">
                                        <li class="list-group-item flex-fill"><strong>Valor Contrato:</strong> <span id="modalValorContrato">@Model?.ValorContrato.ToString("C")</span></li>
                                        <li class="list-group-item flex-fill"><strong>Anticipo:</strong> <span id="modalValorAnticipo">@Model?.ValorAnticipo.ToString("C")</span></li>
                                        <li class="list-group-item flex-fill"><strong>No. Cuotas:</strong> <span id="modalNumeroCuotas">@Model?.NumeroCuotas</span></li>
                                        <li class="list-group-item flex-fill"><strong>Inicio Cuotas:</strong> <span id="modalFechaPrimeraCuota">@Model?.FechaPrimeraCuota</span></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card: Cuotas del Plan -->
                    <div class="card shadow-sm">
                        <div class="card-header py-2">
                            <h6 class="m-0 font-weight-bold text-primary">Cuotas del Plan</h6>
                        </div>
                        <div class="card-body">
                                <div class="table-responsive">
                                    <table id="tblCuotasPlanPago" class="table-modern" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>No. Cuota</th>
                                            <th>Monto Esperado</th>
                                            <th>Monto Pagado</th>
                                            <th>Fecha Vencimiento</th>
                                            <th>Estado</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Data will be loaded by DataTable via AJAX -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
            </div> <!-- Closes modal-body p-3 of detallePlanPagoModal -->
            <div class="modal-footer border-0 p-2">
                <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal"><i class="fas fa-times"></i> Cerrar</button>
                <button type="button" class="btn btn-success btn-sm" id="btnRegistrarPagoModal"><i class="fas fa-money-check-alt"></i> Registrar Pago</button>
            </div>
        </div> <!-- Closes modal-content -->
    </div> <!-- Closes modal-dialog -->
</div> <!-- Closes detallePlanPagoModal -->

<!-- Modal Historial de Pagos por Cuota -->
<div class="modal fade" id="historialPagosCuotaModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content modal-content-premium">
            <div class="modal-header-premium header-primary">
                <h6 class="modal-title">
                    <i class="fas fa-history"></i> Historial de Pagos de la Cuota
                </h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body p-3">
                <div class="table-responsive">
                    <table id="tblHistorialPagos" class="table-modern" style="width:100%">
                        <thead>
                            <tr>
                                <th>Monto Pagado</th>
                                <th>Fecha de Pago</th>
                                <th>Registrado Por</th>
                                <th>Comprobante</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data will be loaded by DataTable via AJAX -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0 p-2">
                <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal"><i class="fas fa-times"></i> Cerrar</button>
            </div>
        </div>
    </div>
</div>
