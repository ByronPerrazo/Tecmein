@model TecmeinWebApp.Models.ViewModel.FormatoNumeroClienteVm

@{ 
    ViewData["Title"] = "Formato Número Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5>Configuración de Formato de Número de Cliente</h5>
    </div>
    <div class="card-body">
        <form id="formatoForm">
            <input type="hidden" asp-for="SecFormatoNumeroCliente" />
            <input type="hidden" asp-for="SecEmpresa" />

            <div class="form-group">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="UsaFormato">
                    <label class="form-check-label" for="UsaFormato">
                        Usar Formato Personalizado
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label for="Formato">Formato</label>
                <input type="text" class="form-control" asp-for="Formato" placeholder="Ej: CLI-{numero}">
            </div>

            <div class="form-group">
                <label for="NumeroInicio">Número de Inicio</label>
                <input type="number" class="form-control" asp-for="NumeroInicio">
            </div>

            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        </form>
    </div>
</div>

@section Scripts{
    <script src="~/js/vistas/FormatoNumeroCliente_Index.js"></script>
}
