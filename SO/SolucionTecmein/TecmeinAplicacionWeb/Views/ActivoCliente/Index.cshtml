@{
    ViewData["Title"] = "Gestión de Activos del Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/styleGenerales.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/premium-design.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/modern-table.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme-overrides.css" asp-append-version="true">
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-boxes text-warning mr-1"></i> Activos del Cliente
        </h6>
    </div>
    <div class="card-body pt-1">
        <div class="row" style="display:none;">
            <div class="col-sm-3">
                <button class="btn btn-success" data-toggle="modal" id="btnNuevo"><i class="fas fa-plus"></i> Nuevo Activo</button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <table id="tablaActivosCliente" class="table-modern" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Cliente</th>
                            <th>Descripción</th>
                            <th>Fecha Instalación</th>
                            <th>Contrato Origen</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear/Editar Activo Cliente -->
<div class="modal fade" id="modalActivoCliente" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header-premium bg-second-primary">
                <h5 class="modal-title m-0 font-weight-bold text-white"><i class="fas fa-boxes text-warning mr-2"></i> Detalle del Activo</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" value="0" id="txtIdActivoCliente">
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label for="cboCliente" class="font-weight-bold">Cliente</label>
                            <select id="cboCliente" class="form-control form-control-sm"></select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label for="txtDescripcion" class="font-weight-bold">Descripción</label>
                            <input type="text" class="form-control form-control-sm" id="txtDescripcion">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label for="txtFechaInstalacion" class="font-weight-bold">Fecha de Instalación</label>
                            <input type="date" class="form-control form-control-sm" id="txtFechaInstalacion">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label for="cboContratoOrigen" class="font-weight-bold">Contrato de Origen</label>
                            <select id="cboContratoOrigen" class="form-control form-control-sm"></select>
                            <small class="form-text text-muted">Opcional. Si el activo está vinculado a un contrato específico.</small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm rounded-pill" id="btnGuardar"><i class="fas fa-save mr-1"></i> Guardar</button>
                <button class="btn btn-danger btn-sm rounded-pill" type="button" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>
    <script src="~/js/vistas/ActivoCliente_Index.js" asp-append-version="true"></script>
}
