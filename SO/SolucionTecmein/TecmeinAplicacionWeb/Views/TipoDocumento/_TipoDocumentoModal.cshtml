<!--  Modal-->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header-premium bg-second-primary">
                <h5 class="modal-title m-0 font-weight-bold text-white"><i class="fas fa-file-alt text-warning mr-2"></i> Detalle Tipo de Documento</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" value="0" id="txtId">
                    <div class="form-row">
                        <div class="form-group col-sm-6">
                            <label for="txtCodigo" class="font-weight-bold">Código</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtCodigo" name="Codigo">
                        </div>
                        <div class="form-group col-sm-6">
                            <label for="txtDescripcion" class="font-weight-bold">Descripción</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtDescripcion" name="Descripcion">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-sm-6">
                            <label for="cboPlantilla" class="font-weight-bold">Plantilla Predeterminada</label>
                            <select class="form-control form-control-sm" id="cboPlantilla">
                                <option value="">Seleccionar...</option>
                            </select>
                        </div>
                        <div class="form-group col-sm-6">
                            <label for="cboEstado" class="font-weight-bold">Estado</label>
                            <select class="form-control form-control-sm" id="cboEstado">
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary btn-sm rounded-pill" type="button" id="btnGuardar"><i class="fas fa-save mr-1"></i> Guardar</button>
                <button class="btn btn-danger btn-sm rounded-pill" type="button" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>