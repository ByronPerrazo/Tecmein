<!-- Modal para el Editor de Pre-Contrato -->
<div class="modal fade" id="modalEditorPreContrato" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content modal-content-premium">
            <div class="modal-header-premium header-primary">
                <h6 class="modal-title">
                    <i class="fas fa-edit"></i> Editor de Contenido del Pre-Contrato
                </h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="hiddnSecPreContratoEditor" value="0" />
                <div class="form-group col-sm-12">
                    <label class="font-weight-bold">Contenido del Pre-Contrato</label>
                    <textarea id="editorContenidoPreContrato" rows="20"></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 p-2">
                <button class="btn btn-primary btn-sm" type="button" id="btnGuardarContenidoEditor"><i class="fas fa-save mr-1"></i> Guardar Contenido</button>
                <button class="btn btn-secondary btn-sm" type="button" data-dismiss="modal"><i class="fas fa-times mr-1"></i> Cerrar</button>
            </div>
        </div>
    </div>
</div>
