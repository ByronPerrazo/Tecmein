<!--  Modal-->
<div class="modal fade" id="modalPreContrato" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content modal-content-premium">
            <div class="modal-header-premium header-primary">
                <h6 class="modal-title">
                    <i class="fas fa-file-signature"></i> Nuevo Pre-Contrato
                </h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body p-3">
                <form>
                    <input type="hidden" value="0" id="txtId">
                    <input type="hidden" value="0" id="SecPreContrato"> <!-- Nuevo campo oculto para el ID del PreContrato -->
                    <!-- Sección Datos Principales: 3 Selectores en línea -->
                    <div class="card mb-3 border-left-primary shadow-sm">
                        <div class="card-body p-2">
                            <small class="text-primary font-weight-bold ml-1 mb-2 d-block">DEFINICIÓN DEL CONTRATO</small>
                            <div class="form-row">
                                <div class="col-md-4">
                                    <label for="cboCotizacionesAceptadas" class="small text-muted mb-0 font-weight-bold">Cotización Aceptada</label>
                                    <select id="cboCotizacionesAceptadas" class="form-control form-control-sm border-left-primary" title="Seleccionar Cotización">
                                        <option value="" disabled selected>-- Seleccionar --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="cboTipoDocumento" class="small text-muted mb-0 font-weight-bold">Tipo de Documento</label>
                                    <select id="cboTipoDocumento" class="form-control form-control-sm border-left-info" title="Seleccionar Tipo">
                                        <option value="" disabled selected>-- Seleccionar --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="PolizaGarantia" class="small text-muted mb-0 font-weight-bold">Póliza de Garantía</label>
                                    <select id="PolizaGarantia" class="form-control form-control-sm border-left-success" title="Seleccionar Póliza">
                                        <option value="" disabled selected>-- Seleccionar --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sección Condiciones y Valores -->
                    <div class="card mb-3 border-left-success shadow-sm">
                        <div class="card-body p-2">
                            <small class="text-success font-weight-bold ml-1 mb-2 d-block">CONDICIONES Y TIEMPOS</small>
                            <div class="form-row mb-2">
                                <!-- Valor Cotización (Read Only) -->
                                <div class="col-md-2">
                                    <label class="small text-muted mb-0 font-weight-bold">Valor Cotización</label>
                                    <div class="input-group input-group-sm">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-white font-weight-bold text-dark">$</span>
                                        </div>
                                        <div id="totalCotizacionDisplay" class="form-control form-control-sm bg-light text-right font-weight-bold text-dark">0.00</div>
                                    </div>
                                </div>

                                <!-- Tiempos de Entrega -->
                                <div class="col-md-3">
                                    <label for="Dias" class="small text-muted mb-0 font-weight-bold">Tiempo Entrega</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" class="form-control form-control-sm" id="Dias" min="0" max="9999" placeholder="0" style="max-width: 60px;">
                                        <div class="input-group-append">
                                            <select id="TipoDias" class="form-control form-control-sm bg-gray-100" style="width: 110px;">
                                                <option value="Hábiles">Hábiles</option>
                                                <option value="Calendario">Calendario</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- Mantenimiento -->
                                <div class="col-md-2">
                                    <label for="PeriodoMantenimiento" class="small text-muted mb-0 font-weight-bold">Mantenimiento</label>
                                    <select id="PeriodoMantenimiento" class="form-control form-control-sm" style="height: 31px;">
                                        <option value="" disabled selected>Frecuencia...</option>
                                        <option value="semanal">Semanal</option>
                                        <option value="quincenal">Quincenal</option>
                                        <option value="mensual">Mensual</option>
                                        <option value="trimestral">Trimestral</option>
                                        <option value="semestral">Semestral</option>
                                        <option value="anual">Anual</option>
                                    </select>
                                </div>

                                <!-- Garantía Técnica -->
                                <div class="col-md-5">
                                     <label class="small text-muted mb-0 font-weight-bold">Garantía Técnica</label>
                                     <div class="input-group input-group-sm">
                                        <input type="number" class="form-control form-control-sm" id="AniosGarantia" min="0" placeholder="0" style="max-width: 80px;">
                                        <div class="input-group-append input-group-prepend">
                                            <span class="input-group-text bg-light border-left-0 border-right-0">Años</span>
                                        </div>
                                        <input type="number" class="form-control form-control-sm" id="MesesGarantia" min="0" placeholder="0" style="max-width: 80px;">
                                        <div class="input-group-append">
                                            <span class="input-group-text bg-light">Meses</span>
                                        </div>
                                     </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sección de Compromisos de Pago -->
                     <div class="card border-left-warning shadow-sm mb-3">
                        <div class="card-header py-1 bg-white border-bottom-warning d-flex align-items-center justify-content-between" id="headingCompromisos" style="cursor: pointer;" data-toggle="collapse" data-target="#collapseCompromisos" aria-expanded="true" aria-controls="collapseCompromisos">
                            <h6 class="m-0 font-weight-bold text-warning small text-uppercase">
                                <i class="fas fa-money-check-alt mr-1"></i> Compromisos de Pago
                            </h6>
                            <i class="fas fa-chevron-down text-gray-400"></i>
                        </div>
                        <div id="collapseCompromisos" class="collapse show" aria-labelledby="headingCompromisos">
                            <div class="card-body p-2">
                                <!-- Sección para Generar Cuotas -->
                                <div class="card p-2 mb-1 border-0 bg-light">
                                    <div class="form-row">
                                        <div class="form-group col-md-3 mb-0">
                                            <label for="numCuotas" class="small mb-0 font-weight-bold text-secondary"># Cuotas</label>
                                            <input type="number" class="form-control form-control-sm" id="numCuotas" min="1" placeholder="Ej: 12">
                                        </div>
                                        <div class="form-group col-md-3 mb-0">
                                            <label for="montoCuota" class="small mb-0 font-weight-bold text-secondary">Monto</label>
                                            <div class="input-group input-group-sm">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text">$</span>
                                                </div>
                                                <input type="number" class="form-control form-control-sm" id="montoCuota" min="0" step="0.01" placeholder="0.00">
                                            </div>
                                        </div>
                                        <div class="form-group col-md-3 mb-0">
                                            <label for="fechaPrimeraCuota" class="small mb-0 font-weight-bold text-secondary">Inicio</label>
                                            <input type="date" class="form-control form-control-sm" id="fechaPrimeraCuota">
                                        </div>
                                        <div class="form-group col-md-3 mb-0">
                                            <label class="small mb-0 d-block">&nbsp;</label>
                                            <button type="button" class="btn btn-warning btn-sm shadow-sm font-weight-bold text-dark btn-block" id="btnGenerarCuotas">
                                                <i class="fas fa-calculator"></i> Generar
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="table-responsive">
                                            <table id="tablaCompromisos" class="table-modern bg-white mb-0" style="width:100%">
                                                <thead class="thead-light text-center">
                                                    <tr>
                                                        <th style="width: 40px;">#</th>
                                                        <th>Concepto</th>
                                                        <th>Valor ($)</th>
                                                        <th>Vencimiento</th>
                                                        <th style="width: 40px;"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <!-- Las filas se agregarán dinámicamente aquí -->
                                                </tbody>
                                                <tfoot>
                                                    <tr class="bg-gray-100">
                                                        <td colspan="2" class="text-right font-weight-bold text-secondary">TOTAL:</td>
                                                        <td id="sumaCompromisosDisplay" class="font-weight-bold text-right text-dark">0.00</td>
                                                        <td colspan="2"></td>
                                                    </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2 btn-block border-dashed" id="btnAnadirCompromiso">
                                            <i class="fas fa-plus-circle"></i> Agregar Fila Manual
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Fin Sección de Compromisos de Pago -->

                    <!-- Sección Documentos (Generación y Carga) -->
                    <div class="card mb-3 border-left-info shadow-sm" id="seccionSubirContrato">
                         <div class="card-body p-2">
                            <small class="text-info font-weight-bold ml-1 mb-2 d-block">DOCUMENTO</small>
                            <div class="row">
                                <!-- Generar Borrador -->
                                <div class="col-md-5 border-right">
                                    <label class="small text-muted mb-1 font-weight-bold">1. Generar Borrador</label>
                                    <button class="btn btn-success btn-block shadow-sm font-weight-bold" type="button" id="btnGenerarPreContrato">
                                        <i class="fas fa-file-contract mr-2"></i> Generar Documento
                                    </button>
                                </div>

                                <!-- Subir Final -->
                                <div class="col-md-7">
                                    <label class="small text-muted mb-1 font-weight-bold">2. Subir Versión Final (DOCX)</label>
                                    <div class="input-group">
                                        <div class="custom-file">
                                            <input type="file" class="custom-file-input" id="fileContratoFinal" accept=".docx">
                                            <label class="custom-file-label" for="fileContratoFinal" data-browse="Buscar">Seleccionar archivo...</label>
                                        </div>
                                        <div class="input-group-append">
                                            <button class="btn btn-info font-weight-bold" type="button" id="btnSubirContratoFinal">
                                                <i class="fas fa-upload mr-1"></i> Subir
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 p-2">
                <button type="button" class="btn btn-primary btn-sm" id="btnGuardarBorrador"><i class="fas fa-save mr-1"></i> Guardar</button>
                <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal"><i class="fas fa-times mr-1"></i> Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- Plantilla para nueva fila de compromiso (oculta) -->
<table style="display:none;">
    <tr id="plantillaCompromiso">
        <td><span class="numero-cuota"></span></td>
        <td>
            <select class="form-control form-control-sm tipo-compromiso">
                <option value="Anticipo">Anticipo</option>
                <option value="Cuota">Cuota</option>
            </select>
        </td>
        <td>
            <input type="number" class="form-control form-control-sm monto-compromiso" min="0" step="0.01" placeholder="Monto">
        </td>
        <td>
            <input type="date" class="form-control form-control-sm fecha-compromiso">
        </td>
        <td>
            <button type="button" class="btn btn-danger btn-sm btn-eliminar-compromiso"><i class="fas fa-trash-alt"></i></button>
        </td>
    </tr>
</table>
