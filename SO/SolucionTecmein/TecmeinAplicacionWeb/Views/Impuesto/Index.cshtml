
@{
    ViewData["Title"] = "Impuestos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/styleGenerales.css">
    <link rel="stylesheet" href="~/css/modern-table.css">
}

<!-- DataTales Example -->
<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Lista de Impuestos</h6>
    </div>
    <div class="card-body pt-1">
        <div class="row">
            <div class="col-sm-3">
                <button class="btn btn-success" data-toggle="modal" id="btnNuevo" data-target="#modalData"><i class="fas fa-plus"></i> Nuevo Impuesto</button>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-12">
                <table class="table-modern" id="tbdata" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Porcentaje</th>
                            <th>Valor Fijo</th>
                            <th>Código SRI</th>
                            <th>Tipo Impuesto</th>
                            <th>Vigente</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                       
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!--  Modal-->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="card shadow-sm">
                <div class="card-header py-2 bg-second-primary">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-percent"></i> Detalle Impuesto
                        <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" class="text-white">×</span>
                        </button>
                    </h6>
                </div>
                <div class="card-body p-2">
                    <form>
                        <input type="hidden" value="0" id="txtId">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="form-row">
                                    <div class="form-group col-sm-6">
                                        <label for="txtCodigo">Código</label>
                                        <input type="text" class="form-control form-control-sm input-validar" id="txtCodigo" name="Codigo">
                                    </div>
                                    <div class="form-group col-sm-6">
                                        <label for="txtDescripcion">Descripción</label>
                                        <input type="text" class="form-control form-control-sm input-validar" id="txtDescripcion" name="Descripcion">
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-sm-6">
                                        <label for="txtPorcentaje">Porcentaje</label>
                                        <input type="number" step="0.01" class="form-control form-control-sm input-validar" id="txtPorcentaje" name="Porcentaje">
                                    </div>
                                    <div class="form-group col-sm-6">
                                        <label for="txtValorFijo">Valor Fijo</label>
                                        <input type="number" step="0.01" class="form-control form-control-sm input-validar" id="txtValorFijo" name="ValorFijo">
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-sm-6">
                                        <label for="txtCodigoSri">Código SRI</label>
                                        <input type="text" class="form-control form-control-sm input-validar" id="txtCodigoSri" name="CodigoSri">
                                    </div>
                                    <div class="form-group col-sm-6">
                                        <label for="cboTipoImpuesto">Tipo Impuesto</label>
                                        <select class="form-control form-control-sm" id="cboTipoImpuesto"></select>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-sm-6">
                                        <label for="cboVigente">Vigente</label>
                                        <select class="form-control form-control-sm" id="cboVigente">
                                            <option value="true">Sí</option>
                                            <option value="false">No</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-body p-0 d-flex justify-content-end">
                    <button class="btn btn-primary btn-sm m-1 mr-2" type="button" id="btnGuardar">Guardar</button>
                    <button class="btn btn-danger btn-sm m-1" type="button" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {

    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>



    <script src="~/js/vistas/Impuesto_Index.js"></script>

}