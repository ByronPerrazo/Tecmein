@model  TecmeinAplicacionWeb.Models.ViewModels.SeguimientoVM

@{ 
    ViewData["Title"] = "Seguimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5>Gestión de Seguimientos</h5>
    </div>
    <div class="card-body">
        <form id="seguimientoForm">
            <input type="hidden" asp-for="SecSeguimiento" />
            <input type="hidden" asp-for="SecCotizacion" />

            <div class="form-group">
                <label for="Accion">Acción</label>
                <input type="text" class="form-control" asp-for="Accion" placeholder="Ej: Llamada, Correo">
            </div>

            <div class="form-group">
                <label for="Detalle">Detalle</label>
                <textarea class="form-control" asp-for="Detalle" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label for="FechaAccion">Fecha de Acción</label>
                <input type="date" class="form-control" asp-for="FechaAccion">
            </div>

            <div class="form-group">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="AceptacionCliente">
                    <label class="form-check-label" for="AceptacionCliente">
                        Aceptación del Cliente
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Guardar Seguimiento</button>
        </form>
    </div>
</div>

@section Scripts{
    <script src="~/js/vistas/Seguimiento_Index.js"></script>
}
