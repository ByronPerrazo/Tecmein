@{
    ViewData["Title"] = "Visitas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model TecmeinAplicacionWeb.Models.ViewModels.VisitaVM

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/styleGenerales.css">
}

<!-- Grilla inicial de proceso -->
<div class="card shadow-sm mb-2">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Lista de Visitas</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-3">
                <button class="btn btn-success" id="btnNuevo">
                    <i class="fas fa-plus-circle"></i>
                    Nueva Visita
                </button>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-12">
                <table class="table table-bordered" id="tbdata" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre Obra</th>
                            <th>Etapa</th>
                            <th>Canton</th>
                            <th>Dirección</th>
                            <th>Mapa</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detalle Visita -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="formVisita">
                <div class="card shadow-sm">
                    <div class="card-header py-2 bg-second-primary">
                        <h6 class="m-0 font-weight-bold text-white">
                            <i class="fas fa-building"></i> Detalle Visita
                            <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true" class="text-white">×</span>
                            </button>
                        </h6>
                    </div>
                    <div class="card-header py-2 bg-second-primary">
                        <h6 class="m-0 font-weight-bold text-white"><i class="fas fa-industry"></i> Obra </h6>
                    </div>
                    <div class="card-body">
                        <input type="hidden" value="0" id="txtId" name="Secuencial">
                        <input type="hidden" value="0" id="txtGeolocallizacion" name="GeoUbicacion">

                        <div class="form-row">
                            <div class="form-group col-sm-10 text-xs">
                                <label class="cab_i_sm text-xs" for="txtNombreObra">Nombre Obra / Proyecto</label>
                                <input type="text" class="form-control form-control-sm text-xs" id="txtNombreObra" name="Nombre">
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-2 text-xs">
                                <label class="cab_i_sm text-xs" for="cboOperador">Operador</label>
                                <select class="form-control form-control-sm text-xs" id="cboOperador" name="SecEmpresa">
                                </select>
                                <span asp-validation-for="SecEmpresa" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-sm-4 text-xs">
                                <label class="cab_i_sm text-xs" for="cboProvincia">Provincia</label>
                                <select class="form-control form-control-sm text-xs" id="cboProvincia" name="SecProvincia">
                                    <option value="" disabled selected>Seleccione Provincia</option>
                                </select>
                                <span asp-validation-for="SecProvincia" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-4 text-xs">
                                <label class="cab_i_sm text-xs" for="cboCanton">Cantón</label>
                                <select class="form-control form-control-sm text-xs" id="cboCanton" name="SecCanton">
                                    <option value="" disabled selected>Seleccione Cantón</option>
                                </select>
                                <span asp-validation-for="SecCanton" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-4 text-xs">
                                <label class="cab_i_sm text-xs" for="cboParroquia">Parroquia</label>
                                <select class="form-control form-control-sm text-xs" id="cboParroquia" name="SecParroquia">
                                    <option value="" disabled selected>Seleccione Parroquia</option>
                                </select>
                                <span asp-validation-for="SecParroquia" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row form-row-compact">
                            <div class="form-group col-sm-12 text-xs">
                                <label class="cab_i_sm" for="txtDireccion">Dirección Obra / Proyecto</label>
                                <input type="text" class="form-control form-control-sm text-xs" id="txtDireccion" placeholder="Dirección" name="Direccion">
                                <span asp-validation-for="Direccion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row form-row-compact">
                            <div class="form-group col-sm-4">
                                <label class="cab_i_sm">Etapa</label>
                                <select class="form-control form-control-sm text-xs" id="cboEtapaObra" name="IdEtapa" onchange="mostrarDiv()" disabled>
                                </select>
                            </div>
                            <div class="form-group col-sm-4" style="display:none">
                                <label class="cab_i_sm">Estado Obra</label>
                                <select class="form-control form-control-sm text-xs" id="cboEstado" name="EstaActivo">
                                    <option value="1">Activo</option>
                                    <option value="0">Inactivo</option>
                                </select>
                            </div>
                            <div class="form-group col-sm-4">
                                <label class="cab_i_sm">Próxima Visita</label>
                                <input type="checkbox" name="esSigVisita" id="chkEsSigVisita">
                                <input type="date" class="form-control form-control-sm validar-fecha-mayor text-xs" id="dtpkFechaSigVisita" style="display:none" name="FechaSiguienteVisita">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-sm-12 text-xs">
                                <label class="cab_i_sm" for="txtDescripcion">Detalle</label>
                                <textarea rows="2" cols="50" class="form-control form-control-sm text-xs" id="txtDescripcion" name="Detalle"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0 d-flex justify-content-end">
                        <button class="btn btn-primary btn-sm m-1 mr-2" type="button" id="btnGuardarVisitas">Guardar</button>
                        <button class="btn btn-danger btn-sm m-1" type="button" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Other Modals remain unchanged -->
<!--Contacto-->
<div class="modal fade" id="modalDataContacto" tabindex="0" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="card shadow-sm">
                <div class="card-header py-2 bg-second-primary">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-id-card"></i> Contacto
                        <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" class="text-white">×</span>
                        </button>
                    </h6>
                </div>
                <div class="card-body p-2">
                    <!--seccion Contacto -->
                    <div class="col-sm-12" id="Detalle_Contacto_vista">
                        <div class="card shadow-sm ml-1">
                            <div class="card-header py-2 bg-second-primary">
                                <h6 class="m-0 font-weight-bold text-white"><i class="fas fa-id-card"></i> Contacto</h6>
                            </div>

                            <div class="card-body Contacto">
                                <div class="form-row">
                                    <div class="form-group col-sm-12">
                                        <i class="cab_i_sm">Constructora</i>
                                        <select class="form-control form-control-sm text-xs"
                                                id="cboEmpresa"
                                                name="Constructora">
                                        </select>
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-group col-sm-12">
                                        <i class="cab_i_sm">Contacto</i>
                                        <select class="form-control form-control-sm text-xs"
                                                id="cboContactos"
                                                name="Contacto">
                                        </select>

                                    </div>
                                </div>

                                <div class="form-row">
                                    <i class="cab_i_sm">Detalle Contacto</i>
                                    <textarea readonly="readonly"
                                              class="form-control form-control-sm text-xs"
                                              id="txtDescripcionContacto"
                                              name="Detalle Contacto"></textarea>
                                </div>
                                <div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0 d-flex justify-content-end">
                    <button class="btn btn-primary btn-sm m-1 mr-2" type="button" id="btnGrdVisitaContacto">Guardar</button>
                    <button class="btn btn-danger btn-sm m-1" type="button" data-dismiss="modal" id="btnCancelVisitaContacto">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!--Detalle de Productos Visita-->
<div class="modal fade" id="modalDataDetalleVisita" tabindex="0" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">

            <!--seccion Detalle lista -->
            <div class="DetalleVisita" id="detalleVisita_Vista">
                <div class="card shadow-sm">
                    <div class="card-header py-2 bg-second-primary">
                        <h6 class="m-0 font-weight-bold text-white">
                            <i class="fas fa-thumbtack"></i> Detalle Visita
                            <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true" class="text-white">×</span>
                            </button>
                        </h6>
                    </div>

                    <div class="card-body p-2">

                        <div class="card shadow-sm mb-4">
                            <div class="card-header py-2 bg-second-primary">
                                <a href="#collapseGeneralInfo" class="d-block card-header-link text-white" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseGeneralInfo">
                                    <h6 class="m-0 font-weight-bold text-white">
                                        <i class="fas fa-info-circle"></i> Información General del Equipo
                                        <i class="fas fa-chevron-down float-right"></i>
                                    </h6>
                                </a>
                            </div>
                            <div id="collapseGeneralInfo" class="collapse show">
                                <div class="card-body p-2">
                                    <div class="form-row form-row-compact">
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Tipo Equipo</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoEquipo" name="Tipo Equipo" title="Tipo Equipo">
                                                <option value="" disabled selected>Tipo Equipo</option>
                                            </select>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Sistema</i>
                                            <select class="form-control form-control-sm text-xs" id="cboSistema" name="Sistema" title="Sistema">
                                                <option value="" disabled selected>Sistema</option>
                                            </select>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Marca</i>
                                            <select class="form-control form-control-sm text-xs" id="cboMarca" name="Marca" title="Marca">
                                                <option value="" disabled selected>Marca</option>
                                            </select>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Sala Maquinas</i>
                                            <select class="form-control form-control-sm text-xs" id="cboSalaMaquinas" name="Sala Maquinas" title="Sala Maquinas">
                                                <option value="" disabled selected>Sala Maquinas</option>
                                            </select>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Tipo Motor</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoMotor" name="Sala Maquinas" title="Tipo Motor">
                                                <option value="" disabled selected>Tipo Motor</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="form-row form-row-compact">
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Velocidad m/s</i>
                                            <select class="form-control form-control-sm text-xs" id="cboVelocidad" name="Velocidad" title="Velocidad m/s">
                                                <option value="" disabled selected>Velocidad m/s</option>
                                            </select>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Capacidad de Carga</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtCapacidad" name="Capacidad" placeholder="Capacidad de Carga" title="Capacidad de Carga">
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">N° Personas</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtNumPersonas" name="Personas" placeholder="N° Personas" title="N° Personas">
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Cantidad</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtCantidad" name="Numero Paradas" placeholder="Cantidad" title="Cantidad">
                                        </div>
                                        <div class="form-group col">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm mb-4">
                            <div class="card-header py-2 bg-second-primary">
                                <a href="#collapseInstallationDetails" class="d-block card-header-link text-white" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseInstallationDetails">
                                    <h6 class="m-0 font-weight-bold text-white">
                                        <i class="fas fa-tools"></i> Detalles de Instalación y Ducto
                                        <i class="fas fa-chevron-down float-right"></i>
                                    </h6>
                                </a>
                            </div>
                            <div id="collapseInstallationDetails" class="collapse show">
                                <div class="card-body pb-1">
                                    <div class="form-row form-row-compact">
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Número Paradas</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtNumParadas" name="Paradas" placeholder="Número Paradas" title="Número Paradas">
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Nombre Paradas</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtNombresParadas" name="Nombre Paradas" placeholder="Nombre Paradas" title="Nombre Paradas">
                                            <div class="invalid-feedback">El número de nombres debe coincidir con el número de paradas (separados por guiones).</div>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Tipo de Embarque</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoEmbarque" name="Tipo Equipo" title="Tipo de Embarque">
                                                <option value="" disabled selected>Tipo de Embarque</option>
                                            </select>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Ducto De</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoDucto" name="Tipo Equipo" title="Ducto De">
                                                <option value="" disabled selected>Ducto De</option>
                                            </select>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Medidas Ducto A-F</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtMedidasDuctoAF" name="Medidas Dcuto AF" placeholder="Medidas Ducto A-F" title="Medidas Ducto A-F">
                                            <div class="invalid-feedback">El formato debe ser NÚMERO * NÚMERO</div>
                                        </div>
                                    </div>
                                    <div class="form-row form-row-compact">
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Foso</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtFoso" name="Foso" placeholder="Foso" title="Foso">
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Recorrido</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtRecorrido" name="Recorrido" placeholder="Recorrido" title="Recorrido">
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Entradas Frontales</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtEntradasFrontales" name="Entradas Frontales" placeholder="Entradas Frontales" title="Entradas Frontales">
                                            <div class="invalid-feedback">El número de Entradas no coicide con las Entradas.</div>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Entradas Posteriores</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtEntradasPosterior" name="Entradas Posteriores" placeholder="Entradas Posteriores" title="Entradas Posteriores">
                                            <div class="invalid-feedback">El número de Entradas no coicide con las Entradas.</div>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Sobre Recorrido</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtSobreRecorrido" name="SobreRecorrido" placeholder="Sobre Recorrido" title="Sobre Recorrido">
                                        </div>
                                    </div>
                                    <div class="form-row form-row-compact">
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Tipo Energía</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoEnergia" name="Tipo Equipo" title="Tipo Energía">
                                                <option value="" disabled selected>Tipo Energía</option>
                                            </select>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Altura Entre Pisos</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtAlturaEntrePisos" name="Altura Entre Pisos" placeholder="Altura Entre Pisos" title="Altura Entre Pisos">
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Dimención Entrada</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtDimencionEntrada" name="Dimención Entradas" placeholder="Dimención Entrada" title="Dimención Entrada">
                                            <div class="invalid-feedback">El formato debe ser NÚMERO * NÚMERO</div>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Material de Puertas</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoMaterial" name="Tipo Equipo" title="Material de Puertas">
                                                <option value="" disabled selected>Material de Puertas</option>
                                            </select>
                                        </div>
                                        <div class="form-group col d-flex align-items-end">
                                            <button class="btn btn-success btn-sm w-100" id="btnAgregarItem" contextmenu="Agregar">
                                                <i class="fas fa-plus-circle"></i> Agregar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm mb-4">

                            <div class="card-header py-2 bg-second-primary">
                                <h6 class="m-0 font-weight-bold text-white"><i class="fas fa-list"></i> Equipos Agregados</h6>
                            </div>
                            <div class="card-body p-2">
                                <div class="form-group form-row">
                                    <div class="col">
                                        <table class="table table-sm text-xs" id="tbDataItems" style="width:100%">
                                            <thead>
                                                <tr>
                                                    <th class="col-sm text-xs">Secuencial</th>
                                                    <th class="col-sm text-xs">Cantidad</th>
                                                    <th class="col-sm text-xs">Detalle</th>
                                                    <th class="col-sm text-xs">DetalleImpresion</th>
                                                    <th class="col-sm text-xs">Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="card-body p-1">
                        <!-- <button class="btn btn-danger btn-sm float-right" type="button" data-dismiss="modal">Cancel</button> -->
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<!--Mapa ubicacion -->
<div class="modal fade" id="modalDataMapa" tabindex="0" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="card shadow-sm">
                <div class="card-header py-2 bg-second-primary">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-map-marker-alt"></i> Ubicación
                        <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" class="text-white">×</span>
                        </button>
                    </h6>
                </div>
                <div class="card-body p-0" id="map"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- DataTables & Extensions -->
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/pdfmake.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/vfs_fonts.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>
    
    <!-- jQuery Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <!-- App Scripts -->
    <script src="~/js/vistas/Visita_Index.js"></script>
    <script src="~/js/vistas/Visita_Contacto_Index.js"></script>
    <script src="~/js/vistas/Vista_Producto_Index.js"></script>
    <script src="~/js/vistas/Controles_Generales.js"></script>
    <script src="~/js/mapa.js"></script>
}