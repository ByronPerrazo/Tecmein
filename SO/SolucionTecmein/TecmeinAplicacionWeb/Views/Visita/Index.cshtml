                                        </div>
                                    </div>

                                    <div class="form-row form-row-compact">
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Velocidad m/s</i>
                                            <select class="form-control form-control-sm text-xs" id="cboVelocidad" name="Velocidad" title="Velocidad m/s">
                                                <option value="" disabled selected>Velocidad m/s</option>
                                            </select>
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Capacidad de Carga</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtCapacidad" name="Capacidad" placeholder="Capacidad de Carga" title="Capacidad de Carga">
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">N° Personas</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtNumPersonas" name="Personas" placeholder="N° Personas" title="N° Personas">
                                        </div>
                                        <div class="form-group col">
                                            <i class="cab_i_sm_equipos">Cantidad</i>
                                            <input type="text" class="form-control form-control-sm text-xs" id="txtCantidad" name="Numero Paradas" placeholder="Cantidad" title="Cantidad">
                                        </div>
                                        <div class="form-group col">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                <div class="form-section-premium mb-3">
                    <a href="#collapseInstallationDetails" class="d-block text-decoration-none" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseInstallationDetails">
