@{
    ViewData["Title"] = "Visitas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/styleGenerales.css">

}

<!-- Grilla inicial de proceso -->
<div class="card shadow mb-2">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Lista de Visitas</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-3">
                <button class="btn btn-success" id="btnNuevo" data-toggle="modal" data-target="#modalData"><i class="fas fa-plus-circle"></i> Nueva Visita</button>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-12">
                <table class="table table-bordered" id="tbdata" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre Obra</th>
                            <th>Provincia</th>
                            <th>Canton</th>
                            <th>Dirección</th>
                            <th>Mapa</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Datatalle Visita -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h6>Detalle Visita</h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">

                <form>
                    <div class="row">
                        <!--Seccion Superior -->
                        <div class="col-sm-12">
                            <div class="row">
                                <!--seccion Obra -->
                                <div class="col-sm-8">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3 bg-second-primary">
                                            <h6 class="m-0 font-weight-bold text-white"><i class="fas fa-factory"></i> Obra </h6>
                                        </div>

                                        <div class="card-body">
                                            <input type="hidden" value="0" id="txtId">
                                            <input type="hidden" value="0" id="txtGeolocallizacion">

                                            <div class="form-row">
                                                <div class="form-group col-sm-10 text-xs">
                                                    <i class="cab_i_sm">Nombre Obra / Proyecto</i>
                                                    <input type="text" class="form-control form-control-sm text-xs"
                                                           name="Nombre Proyecto"
                                                           id="txtNombreObra">
                                                </div>
                                                <div class="form-group col-sm-2 text-xs">
                                                    <i class="cab_i_sm">Operador</i>
                                                    <select class="form-control form-control-sm  text-xs" id="cboOperador" name="Operador">
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-row">
                                                <div class="form-group col-sm-4 text-xs">
                                                    <i class="cab_i_sm">Provincia</i>
                                                    <select class="form-control form-control-sm  text-xs" id="cboProvincia" name="Provincia">
                                                    </select>
                                                </div>
                                                <div class="form-group col-sm-4 text-xs">
                                                    <i class="cab_i_sm">Cantón</i>
                                                    <select class="form-control form-control-sm  text-xs"
                                                            id="cboCanton"
                                                            name="Canton">
                                                    </select>
                                                </div>
                                                <div class="form-group col-sm-4 text-xs">
                                                    <i class="cab_i_sm">Parroquia</i>
                                                    <select class="form-control form-control-sm text-xs"
                                                            id="cboParroquia"
                                                            name="Parroquia">
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-row">
                                                <div class="form-group col-sm-12 text-xs">
                                                    <i class="cab_i_sm">Dirección Obra / Proyecto</i>
                                                    <input type="text" class="form-control form-control-sm" id="txtDireccion" placeholder="Dirección" name="Dirección">
                                                </div>

                                            </div>

                                            <div class="form-row">
                                                <div class="form-group col-sm-4">
                                                    <i class="cab_i_sm">Tipo Obra</i>
                                                    <select class="form-control form-control-sm text-xs"
                                                            id="cboTipoObra"
                                                            name="Tipo">
                                                        <option value="MAN">Mantenimiento</option>
                                                        <option value="MOD">Modernización</option>
                                                        <option value="NEW">Nuevo Equipo</option>
                                                    </select>
                                                </div>
                                                <div class="form-group col-sm-4">
                                                    <i class="cab_i_sm">Etapa</i>
                                                    <select class="form-control form-control-sm  text-xs"
                                                            id="cboEtapaObra"
                                                            name="Etapa">
                                                        <option value="COT">Cotización</option>
                                                        <option value="SEG">Seguimiento</option>
                                                        <option value="PRE">Pre-Contrato</option>
                                                        <option value="CON">Contrato</option>
                                                        <option value="PRE">Por Renovar</option>
                                                    </select>
                                                </div>
                                                <div class="form-group col-sm-4">
                                                    <i class="cab_i_sm">Estado Obra</i>
                                                    <select class="form-control form-control-sm text-xs" id="cboEstado">
                                                        <option value="1">Activo</option>
                                                        <option value="0">Inactivo</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <!--seccion Contrato -->

                                            <div class="form-row">
                                                <div class="form-group col-sm-4">
                                                    <i class="cab_i_sm">Poliza</i>
                                                    <select class="form-control form-control-sm text-xs" id="cboPoliza">
                                                        <option value="0">NO</option>
                                                        <option value="0">LETRA DE CAMBIO</option>
                                                        <option value="0">BUA</option>
                                                        <option value="0">CC</option>
                                                        <option value="0">AP</option>
                                                        <option value="0">RC</option>
                                                        <option value="0">BUA+CC</option>
                                                        <option value="0">BUA+AP</option>
                                                        <option value="0">BUA+RC</option>
                                                        <option value="0">BUA+CC+AP</option>
                                                        <option value="0">BUA+CC+RC</option>
                                                        <option value="0">BUA+AP+RC</option>
                                                        <option value="0">BUA+CC+AP+RC</option>



                                                    </select>
                                                </div>
                                                <div class="form-group col-sm-4 text-xs">
                                                    <i class="cab_i_sm">Valor</i>
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           id="txtvalor"
                                                           placeholder="Valor Contrato"
                                                           name="Valor Contrato">
                                                </div>
                                                <div class="form-group col-sm-4 text-xs">
                                                    <i class="cab_i_sm">Dias Entrega</i>
                                                    <input type="number"
                                                           class="form-control form-control-sm"
                                                           id="txtDiasEntrega"
                                                           name="Valor Contrato">
                                                </div>
                                                
                                            </div>

                                            <div class="form-row">
                                                
                                                <div class="form-group col-sm-4">
                                                    <i class="cab_i_sm">Próxima Visita</i>
                                                    <input type="checkbox" name="esSigVisita" id="chkEsSigVisita">
                                                    <input type="date"
                                                           class="form-control form-control-sm validar-fecha-mayor text-xs"
                                                           id="dtpkFechaSigVisita" style="display:none"
                                                           name="Fecha Siguiente Visita">
                                                </div>
                                                <div class="form-group col-sm-4">
                                                    <i class="cab_i_sm">Fecha Contrato</i>
                                                    <input type="date"
                                                           class="form-control form-control-sm validar-fecha-mayor text-xs"
                                                           id="dtpkFechaContrato"
                                                           name="Fecha Contrato">
                                                </div>
                                                <div class="form-group col-sm-4">

                                                    <i class="cab_i_sm">Anticipo Pagado:</i>
                                                    <input type="checkbox" name="anticipoPagado" id="chkAnticipoPagado">
                                                    <input type="date"
                                                           class="form-control form-control-sm validar-fecha-mayor text-xs"
                                                           id="dtpkFechaAnticipo"
                                                           name="Fecha Anticipio">
                                                </div>

                                            </div>

                                            <div class="form-row">
                                                <div class="form-group col-sm-12">
                                                    <i class="cab_i_sm">Detalle</i>
                                                    <textarea rows="2" cols="50" class="form-control form-control-sm input-validar text-xs" id="txtDescripcion" name="Detalle"></textarea>
                                                </div>
                                            </div>


                                        </div>

                                    </div>
                                </div>

                                <!--seccion Contacto -->
                                <div class="col-sm-4">
                                    <div class="card shadow mb-4">
                                        <div class="card-header py-3 bg-second-primary">
                                            <h6 class="m-0 font-weight-bold text-white"><i class="fas fa-id-card"></i> Contacto</h6>
                                        </div>

                                        <div class="card-body">
                                            <div class="form-row">
                                                <div class="form-group col-sm-12">
                                                    <i class="cab_i_sm">Empresa</i>
                                                    <select class="form-control form-control-sm text-xs" id="cboEmpresa"
                                                            name="Abreviatura">
                                                        <option value="ND">No Definida</option>
                                                        <option value="Rosa">El Rosal</option>
                                                        <option value="MetQ">Metro Quito</option>
                                                        <option value="Mont">Montero</option>
                                                        <option value="HPaute">Hidro Paute</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-row">
                                                <div class="form-group col-sm-4">
                                                    <i class="cab_i_sm">Abrev.</i>
                                                    <select class="form-control form-control-sm text-xs" id="cboAbreviatura"
                                                            name="Abreviatura">
                                                        <option value="Sr">Sr/a.</option>
                                                        <option value="Ing">Ing</option>
                                                        <option value="Arq">Arq</option>
                                                        <option value="Dr">Dr/a</option>
                                                        <option value="ND">ND</option>
                                                    </select>
                                                </div>
                                                @*  </div>
                                                <div class="form-row"> *@
                                                <div class="form-group col-sm-8">
                                                    <i class="cab_i_sm">Nombre</i>
                                                    <input type="text" class="form-control form-control-sm text-xs validar-texto text-xs" id="txtNombreContacto" placeholder="Nombre Contacto" name="Nombre ">
                                                </div>
                                            </div>
                                            <div class="form-row">
                                                <div class="form-group col-sm-12">
                                                    <i class="cab_i_sm">Apellidos</i>
                                                    <input type="text" class="form-control form-control-sm validar-texto text-xs" id="txtApellidoContacto" placeholder="Apellido Contacto" name="Apellido ">
                                                </div>
                                            </div>
                                            <div class="form-row">

                                                <div class="form-group col-sm-12">
                                                    <i class="cab_i_sm">Correo</i>
                                                    <input type="text" class="form-control form-control-sm validar-email text-xs" id="txtCorreoContacto" placeholder="Correo">

                                                </div>
                                            </div>
                                            <div class="form-row">
                                                <div class="form-group col-sm-12">
                                                    <i class="cab_i_sm">Teléfono</i>
                                                    <input type="text" class="form-control form-control-sm validar-telefono text-xs" id="txtTelefonoContacto" placeholder="Teléfono" name="Teléfono">
                                                </div>



                                            </div>

                                        </div>
                                    </div>
                                </div>


                            </div>

                        </div>
                        <div class="col-sm-12">
                            <div class="card shadow mb-4">
                                <div class="card-header py-3 bg-second-primary">
                                    <h6 class="m-0 font-weight-bold text-white"> <i class="fas fa-thumbtack"></i> Detalle Visita</h6>
                                </div>
                                <div class="card-body">

                                    <div class="form-row">
                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Tipo Equipo</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoEquipo" name="Tipo Equipo">
                                                <option value="COME">A. Comercial</option>
                                                <option value="RESI">A. Residencial</option>
                                                <option value="MPLA">A. Montaplatos</option>
                                                <option value="HOSP">A. Para Hospital</option>
                                                <option value="MCAR">A. Montacargas</option>
                                                <option value="MCOC">A. Montacoches</option>
                                                <option value="ESEL">E. Eléctricas</option>
                                                <option value="PARO">Pas. Rodantes  </option>
                                                <option value="P360">Panoramico 360</option>
                                                <option value="P270">Panoramico 270</option>
                                                <option value="P180">Panoramico 180</option>
                                                <option value="PA90">Panoramico 90</option>
                                            </select>
                                        </div>

                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Sistema</i>
                                            <select class="form-control form-control-sm text-xs" id="cboSistema" name="Sistema">
                                                <option value="Sim">Simplex</option>
                                                <option value="Dup">Duplex</option>
                                                <option value="Tri">Triplex</option>
                                                <option value="Cua">Cuadruplex</option>
                                                <option value="Qui">Quintuplex</option>
                                            </select>
                                        </div>

                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Marca</i>
                                            <select class="form-control form-control-sm text-xs" id="cboMarca" name="Marca">
                                                <option value="ANDI">ANDINO</option>
                                                <option value="AUTO">AUTOMAC</option>
                                                <option value="COUR">CONTROLES S.A. (URU)</option>
                                                <option value="DOPP">DOPPLER</option>
                                                <option value="FUJI">FUJI</option>
                                                <option value="FUYI">FUJI-YIDA</option>
                                                <option value="HYUN">HYUNDAI</option>
                                                <option value="IDE">IDE</option>
                                                <option value="KONE">KONE</option>
                                                <option value="LG">LG</option>
                                                <option value="MITS">MITSUBISHI</option>
                                                <option value="MOVI">MOVILIFT</option>
                                                <option value="ORON">ORONA</option>
                                                <option value="OTIS">OTIS</option>
                                                <option value="SCHI">SCHINDLER</option>
                                                <option value="SIGM">SIGMA</option>
                                                <option value="TECM">TECMEIN</option>
                                                <option value="TKET">TKE-THYSSENKRUPP</option>
                                                <option value="OTRO">OTROS</option>
                                            </select>
                                        </div>
                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Capacidad</i>
                                            <input type="text" class="form-control form-control-sm text-xs"
                                                   id="txtCapacidad"
                                                   name="Capacidad">
                                        </div>

                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Sala Maquinas</i>
                                            <select class="form-control form-control-sm text-xs" id="cboSalaMaquinas" name="Sala Maquinas">
                                                <option value="MR">MR</option>
                                                <option value="MRL">MRL</option>
                                            </select>
                                        </div>

                                        <div class="form-group col-sm-1">
                                            <i class="cab_i_sm">V. m/s</i>
                                            <select class="form-control form-control-sm text-xs" id="cboVelocidad" name="Velocidad">
                                                <option value="MR">0.50</option>
                                                <option value="MR">0.75</option>
                                                <option value="MRL">1.00</option>
                                                <option value="MRL">1.50</option>
                                                <option value="MRL">1.75</option>
                                                <option value="MRL">2.00</option>
                                                <option value="MRL">2.50</option>
                                                <option value="MRL">3.00</option>
                                            </select>
                                        </div>
                                        <div class="form-group col-sm-1">
                                            <i class="cab_i_sm">Sala</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoMotor" name="Sala Maquinas">
                                                <option value="MR">MR</option>
                                                <option value="MRL">MRL</option>
                                            </select>
                                        </div>

                                    </div>

                                    <div class="form-row">

                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Personas</i>
                                            <input type="text" class="form-control form-control-sm  text-xs"
                                                   id="txtNumPersonas" name="Personas">

                                        </div>

                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">N° Paradas</i>
                                            <input type="text" class="form-control form-control-sm  text-xs"
                                                   id="txtNumParadas" name="Paradas">

                                        </div>

                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Embarque</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoEmbarque" name="Tipo Equipo">
                                                <option value="Sim">Simple</option>
                                                <option value="Dob">Doble</option>
                                            </select>
                                        </div>

                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Ducto De</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoDucto" name="Tipo Equipo">
                                                <option value="Sim">Concreto</option>
                                                <option value="Dob">Bloque</option>
                                                <option value="Dob">Estructura</option>
                                            </select>
                                        </div>
                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Dimension A-F</i>
                                            <input type="text" class="form-control form-control-sm  text-xs" id="txtDimensionAF" name="Dimension AF">

                                        </div>
                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Foso</i>
                                            <input type="text"
                                                   class="form-control form-control-sm  text-xs"
                                                   id="txtFoso" name="Foso">

                                        </div>

                                    </div>


                                    <div class="form-row">
                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Recorrido</i>
                                            <input type="text"
                                                   class="form-control form-control-sm  text-xs"
                                                   id="txtRecorrido"
                                                   name="Recorrido">

                                        </div>
                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Ingre. Frontal</i>
                                            <input type="text"
                                                   class="form-control form-control-sm text-xs"
                                                   id="txtIngFrontal"
                                                   name="Ingreso Frontal">

                                        </div>
                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Ingre. Posterior</i>
                                            <input type="text"
                                                   class="form-control form-control-sm text-xs"
                                                   id="txtIngPosterior"
                                                   name="Ingreso Posterior">

                                        </div>

                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">N° Paradas</i>
                                            <input type="text"
                                                   class="form-control form-control-sm text-xs"
                                                   id="txtNumPersonas"
                                                   name="Numero Paradas">

                                        </div>
                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">S. Recorrido</i>
                                            <input type="text"
                                                   class="form-control form-control-sm text-xs"
                                                   id="txtSobreRecorrido"
                                                   name="SobreRecorrido">

                                        </div>

                                    </div>

                                    <div class="form-row">


                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Nombre Paradas</i>
                                            <input type="text"
                                                   class="form-control form-control-sm text-xs"
                                                   id="txtNombresParadas"
                                                   name="Nombre Paradas">

                                        </div>
                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Energía</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoEnergia" name="Tipo Equipo">
                                                <option value="Bi220">Bifasico 220</option>
                                                <option value="Tr220">Trifasico 220</option>
                                            </select>
                                        </div>
                                        <div class="form-group col-sm-3">
                                            <i class="cab_i_sm">Alt. Entre Piso</i>
                                            <input type="text"
                                                   class="form-control form-control-sm text-xs"
                                                   id="txtAlturaEntrePisos"
                                                   name="Nombre Paradas">

                                        </div>

                                        <div class="form-group col-sm-3">
                                            <i class="cab_i_sm">Material Puertas</i>
                                            <select class="form-control form-control-sm text-xs" id="cboTipoMaterial" name="Tipo Equipo">
                                                <option value="AceIno">Acero Inoxidable</option>
                                                <option value="AcePint">Acero Pintado</option>
                                                <option value="InoxVid">Acero Inox-Vidrio</option>

                                            </select>
                                        </div>

                                        <div class="form-group col-sm-2">
                                            <i class="cab_i_sm">Camtidad de Items</i>
                                            <input type="text"
                                                   class="form-control form-control-sm text-xs"
                                                   id="txtCantidad"
                                                   name="Numero Paradas">

                                        </div>

                                    </div>

                                    <div class="form-row">
                                        <div class="col-sm-4">
                                            <button class="btn btn-success  text-sm-right text-xs"
                                                    id="btnAgregar"
                                                    data-toggle="modal"
                                                    data-target="#modalData">
                                                <i class="fas fa-plus-circle text-xs"></i> Agregar
                                            </button>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-sm-12">
                                            <table class="table table-bordered" id="tbdata" cellspacing="0" style="width:100%">
                                                <thead>
                                                    <tr>
                                                        <th>#</th>
                                                        <th>Equipo</th>
                                                        <th>Detalle</th>
                                                        <th>Capacidad</th>
                                                        <th>Marca</th>
                                                        <th>Estado</th>
                                                        <th>Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>


                </form>

            </div>
            <div class="modal-footer">
                <button class="btn btn-primary btn-sm" type="button" id="btnGuardarVisitas">Guardar</button>
                <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!--Mapa ubicacion -->
<div class="modal fade" id="modalDataMapa" tabindex="0" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
