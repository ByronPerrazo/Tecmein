@{
    ViewData["Title"] = "Visitas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model TecmeinAplicacionWeb.Models.ViewModels.VisitaVM

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/styleGenerales.css">
    <link rel="stylesheet" href="~/css/premium-design.css">
    <link rel="stylesheet" href="~/css/modern-table.css">
    <link rel="stylesheet" href="~/css/theme-overrides.css">
    <style>
        :root {
            --app-primary: #4e73df;
            --app-secondary: #858796;
            --app-sidebar: #4e73df;
            --app-text-primary: #ffffff;
            --app-primary-rgb: 78, 115, 223;
        }
        /* Ajustes para formulario más compacto */
        .form-section-premium {
            padding: 6px 10px !important;
            margin-bottom: 8px !important;
        }
        .modal-body {
            padding: 10px !important;
        }
        .form-group {
            margin-bottom: 8px !important;
        }
        .cab_i_sm {
            font-size: 0.72rem !important;
            margin-bottom: 2px !important;
            display: block;
        }
        /* Cabecera Premium Flexbox para alinear titulo y boton cerrar */
        .modal-header-premium {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-header-premium .close {
            color: #ffffff !important;
            opacity: 0.8;
            text-shadow: none;
            padding: 0;
            margin: 0;
        }
        .modal-header-premium .close:hover {
            opacity: 1;
            color: #ffffff !important;
        }
        
        /* Smart Location Picker */
        .location-picker-trigger {
            background: #fff;
            border: 1.5px solid #d1d9e6;
            border-radius: 8px;
            padding: 8px 12px;
            cursor: pointer;
            font-size: 0.85rem;
            color: #5a5c69;
            transition: all 0.2s;
            position: relative;
        }
        .location-picker-trigger:hover {
            border-color: #4e73df;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.15);
        }
        .location-picker-dropdown {
            position: absolute;
            top: 100%;
            left: 5px;
            right: 5px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            border: 1px solid #edf2f9;
            z-index: 1050;
            margin-top: 4px;
        }

        /* Ajustes compactos para el formulario premium */
        #formVisita .form-group {
            margin-bottom: 0.4rem;
        }
        #formVisita .cab_i_sm {
            margin-bottom: 0.15rem;
            font-size: 0.75rem;
            color: #5a5c69;
            font-weight: 600;
        }
        #formVisita .form-control-premium,
        #formVisita .location-picker-trigger {
            padding: 0.25rem 0.5rem;
            font-size: 0.8rem;
            height: auto;
            min-height: 30px;
            border-radius: 6px;
        }
        #formVisita textarea.form-control-premium {
            min-height: 40px;
            line-height: 1.2;
        }
        
        /* Ajustes para diseño depurado de tabla */
        .dataTables_wrapper .row {
            margin-bottom: 2px !important;
            margin-top: 2px !important;
        }
        .dataTables_filter input {
            height: 32px !important;
            padding: 5px 10px 5px 30px !important;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="%236c757d" class="bi bi-search" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>');
            background-repeat: no-repeat;
            background-position: left 10px center;
            border-radius: 5px !important;
            border: 1px solid #ced4da !important;
        }
        .table-modern thead th {
            background-color: #005f73 !important; /* Azul petróleo / Teal oscuro */
            color: white !important;
            font-size: 0.75rem !important;
            text-transform: uppercase;
        }
        /* Quitar fondo y bordes a botones de exportación de DataTables y agregar efecto de escala */
        .dataTables_wrapper .dt-buttons .btn,
        .dataTables_wrapper .dt-buttons .btn-link,
        .dt-buttons .dt-button {
            background: none !important;
            background-color: transparent !important;
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            outline: none !important;
            padding: 5px !important;
            transition: transform 0.2s ease !important;
        }
        .dataTables_wrapper .dt-buttons .btn:hover,
        .dataTables_wrapper .dt-buttons .btn-link:hover,
        .dt-buttons .dt-button:hover {
            background: none !important;
            background-color: transparent !important;
            border: none !important;
            box-shadow: none !important;
            transform: scale(1.2) !important;
        }
        .rounded-pill {
            border-radius: 50rem !important;
        }
        /* Asegurar misma altura para el botón Nuevo y el buscador */
        #btnNuevo {
            height: 32px !important;
            padding: 0 12px !important;
            font-size: 0.85rem !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 5px !important;
        }
        /* Hacer el botón de acciones más cuadrado */
        .table-modern .dropdown-toggle {
            border-radius: 5px !important;
        }
    </style>
}

<!-- Grilla inicial de proceso -->
<div class="card shadow-sm mb-2">
    <div class="card-header py-3 header-primary">
        <h6 class="m-0 font-weight-bold text-white">Lista de Visitas</h6>
    </div>
    <div class="card-body pt-1">
        <div class="row mb-3">
            <div class="col-sm-12">
                <button class="btn btn-primary" id="btnNuevo">
                    <i class="fas fa-plus-circle"></i>
                    <span class="d-none d-sm-inline">Nueva Visita</span>
                    <span class="d-inline d-sm-none">Nuevo</span>
                </button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <table class="table-modern" id="tbdata" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre Obra</th>
                            <th>Etapa</th>
                            <th>Canton</th>
                            <th>Dirección</th>
                            <th>Mapa</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Detalle Visita -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content modal-content-premium">
            <form id="formVisita">
                <div class="modal-header-premium header-primary">
                    <h6 class="modal-title">
                        <i class="fas fa-building"></i> Detalle Visita
                    </h6>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                
                <div class="modal-body">
                    <!-- Sección Obra -->
                    <div class="form-section-premium">
                        <h6 class="font-weight-bold text-primary mb-2" style="font-size: 0.85rem;"><i class="fas fa-industry"></i> Información de la Obra</h6>
                        
                        <input type="hidden" value="0" id="txtId" name="Secuencial">
                        <input type="hidden" value="0" id="txtGeolocallizacion" name="GeoUbicacion">

                        <div class="form-row">
                            <div class="form-group col-sm-5">
                                <label class="cab_i_sm" for="txtNombreObra">Nombre Obra / Proyecto</label>
                                <input type="text" class="form-control-premium w-100" id="txtNombreObra" name="Nombre">
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-4">
                                <label class="cab_i_sm" for="cboOperador">Operador</label>
                                <select class="form-control-premium w-100" id="cboOperador" name="SecEmpresa">
                                </select>
                                <span asp-validation-for="SecEmpresa" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-3">
                                <label class="cab_i_sm">Etapa</label>
                                <select class="form-control-premium w-100" id="cboEtapaObra" name="IdEtapa" disabled>
                                </select>
                            </div>
                        </div>
                        
                        <div class="form-row">
                            <!-- Ubicación Geográfica Smart Picker -->
                            <div class="form-group col-sm-6 position-relative">
                                <label class="cab_i_sm text-primary">
                                    <i class="fas fa-map-marker-alt"></i> Div. Política
                                </label>
                                <div class="location-picker-trigger d-flex justify-content-between align-items-center" id="btnLocationPicker">
                                    <span id="lblLocationText" class="text-secondary font-weight-bold text-truncate" style="max-width: 90%;">Seleccione Provincia...</span>
                                    <i class="fas fa-chevron-down text-primary"></i>
                                </div>
                                
                                <!-- Dropdown Flotante -->
                                <div class="location-picker-dropdown d-none p-2" id="dropdownLocationPicker">
                                    <div class="form-row">
                                        <div class="form-group col-sm-4 mb-0">
                                            <label class="text-xs font-weight-bold text-secondary mb-1">1. Provincia</label>
                                            <select class="form-control-premium w-100" id="cboProvincia" name="SecProvincia">
                                                <option value="" disabled selected>Seleccione...</option>
                                            </select>
                                        </div>
                                        <div class="form-group col-sm-4 mb-0">
                                            <label class="text-xs font-weight-bold text-secondary mb-1">2. Cantón</label>
                                            <select class="form-control-premium w-100" id="cboCanton" name="SecCanton" disabled>
                                                <option value="" disabled selected>Esperando...</option>
                                            </select>
                                        </div>
                                        <div class="form-group col-sm-4 mb-0">
                                            <label class="text-xs font-weight-bold text-secondary mb-1">3. Parroquia</label>
                                            <select class="form-control-premium w-100" id="cboParroquia" name="SecParroquia" disabled>
                                                <option value="" disabled selected>Esperando...</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-end mt-2 pt-2 border-top">
                                        <button type="button" class="btn btn-sm btn-light mr-2 py-0 px-2" style="font-size:0.75rem;" id="btnCloseLocationPicker">Cerrar</button>
                                        <button type="button" class="btn btn-sm btn-primary py-0 px-2" style="font-size:0.75rem;" id="btnConfirmLocation">
                                            <i class="fas fa-check"></i> Confirmar
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-sm-6">
                                <label class="cab_i_sm" for="txtDireccion">Dirección Obra / Proyecto</label>
                                <input type="text" class="form-control-premium w-100" id="txtDireccion" placeholder="Dirección" name="Direccion">
                                <span asp-validation-for="Direccion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-sm-8">
                                <label class="cab_i_sm" for="txtDescripcion">Detalle de Visita</label>
                                <textarea rows="1" class="form-control-premium w-100" id="txtDescripcion" name="Detalle"></textarea>
                            </div>
                            <div class="form-group col-sm-4">
                                <label class="cab_i_sm">Próxima Visita</label>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <input type="checkbox" name="esSigVisita" id="chkEsSigVisita">
                                    <input type="date" class="form-control-premium" id="dtpkFechaSigVisita" style="display:none; padding: 2px 5px;" name="FechaSiguienteVisita">
                                </div>
                            </div>
                        </div>

                        <div class="form-row" style="display:none">
                            <div class="form-group col-sm-12">
                                <select class="form-control-premium w-100" id="cboEstado" name="EstaActivo">
                                    <option value="1">Activo</option>
                                    <option value="0">Inactivo</option>
                                </select>
                            </div>
                        </div>
                        
                        <!-- Contacto a 3 columnas -->
                        <div class="mt-2 border-top pt-2" id="Detalle_Contacto_vista">
                            <h6 class="font-weight-bold text-secondary mb-2" style="font-size: 0.75rem;">
                                <i class="fas fa-id-card text-primary"></i> Información de Contacto
                            </h6>
                            <div class="form-row">
                                <div class="form-group col-sm-4">
                                    <label class="cab_i_sm">Constructora</label>
                                    <select class="form-control-premium w-100" id="cboEmpresa" name="Constructora"></select>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label class="cab_i_sm">Contacto</label>
                                    <select class="form-control-premium w-100" id="cboContactos" name="Contacto"></select>
                                </div>
                                <div class="form-group col-sm-4">
                                    <label class="cab_i_sm d-block" style="visibility:hidden;">Detalle</label>
                                    <textarea readonly="readonly" class="form-control-premium w-100 border-0 bg-light text-muted" id="txtDescripcionContacto" name="Detalle Contacto" style="resize:none; padding:4px;" rows="2" placeholder="Información no disponible"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer border-0 p-2">
                    <button class="btn btn-primary btn-sm" type="button" id="btnGuardarVisitas">Guardar</button>
                    <button class="btn btn-danger btn-sm" type="button" data-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Other Modals remain unchanged -->


<!--Detalle de Productos Visita-->
<div class="modal fade" id="modalDataDetalleVisita" tabindex="0" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content modal-content-premium">
            <div class="modal-header-premium header-primary">
                <h6 class="modal-title">
                    <i class="fas fa-cogs"></i> Detalle Visita - Equipos
                </h6>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            
            <div class="modal-body p-3 DetalleVisita" id="detalleVisita_Vista">
                <div class="form-section-premium mb-3">
                    <a href="#collapseGeneralInfo" class="d-block text-decoration-none" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseGeneralInfo">
