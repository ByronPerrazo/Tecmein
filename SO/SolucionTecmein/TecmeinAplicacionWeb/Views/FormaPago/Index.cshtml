@model TecmeinWebApp.Models.ViewModel.FormaPagoVM

@{ 
    ViewData["Title"] = "Formas de Pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h5>Gestión de Formas de Pago</h5>
    </div>
    <div class="card-body">
        <form id="formaPagoForm">
            <input type="hidden" asp-for="SecFormaPago" />

            <div class="form-group">
                <label for="Descripcion">Descripción</label>
                <input type="text" class="form-control" asp-for="Descripcion" placeholder="Ej: Efectivo, Tarjeta">
            </div>

            <div class="form-group">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="EstaActivo">
                    <label class="form-check-label" for="EstaActivo">
                        Está Activo
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Guardar Forma de Pago</button>
        </form>
    </div>
</div>

@section Scripts{
    <script src="~/js/vistas/FormaPago_Index.js"></script>
}
