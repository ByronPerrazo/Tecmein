@model  TecmeinAplicacionWeb.Models.ViewModels.FormaPagoVM

@{ 
    ViewData["Title"] = "Formas de Pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/styleGenerales.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/premium-design.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/modern-table.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme-overrides.css" asp-append-version="true">
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-credit-card text-warning mr-1"></i> Lista de Formas de Pago
        </h6>
    </div>
    <div class="card-body pt-1">
        <div class="row" style="display:none;">
            <div class="col-sm-3">
                <button class="btn btn-success" id="btnNuevaFormaPago"><i class="fas fa-plus"></i> Nueva Forma de Pago</button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <table id="tbFormaPago" class="table-modern" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Forma de Pago -->
<div class="modal fade" id="modalFormaPago" tabindex="-1" role="dialog" aria-labelledby="modalFormaPagoLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header-premium bg-second-primary">
                <h5 class="modal-title m-0 font-weight-bold text-white" id="modalFormaPagoLabel"><i class="fas fa-credit-card text-warning mr-2"></i> Forma de Pago</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="formaPagoForm">
                    <input type="hidden" asp-for="SecFormaPago" />
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label for="Descripcion" class="font-weight-bold">Descripción</label>
                            <input type="text" class="form-control form-control-sm" asp-for="Descripcion" placeholder="Ej: Efectivo, Tarjeta">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" asp-for="EstaActivo">
                                <label class="custom-control-label font-weight-bold" for="EstaActivo">Está Activo</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm rounded-pill" id="btnGuardarFormaPago"><i class="fas fa-save mr-1"></i> Guardar</button>
                <button type="button" class="btn btn-danger btn-sm rounded-pill" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>
    <script src="~/js/vistas/FormaPago_Index.js" asp-append-version="true"></script>
}
