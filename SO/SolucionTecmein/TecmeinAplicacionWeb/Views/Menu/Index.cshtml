@{
    ViewData["Title"] = "Menús";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link href="~/vendor/select2/select2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/styleGenerales.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/premium-design.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/modern-table.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme-overrides.css" asp-append-version="true">
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-bars text-warning mr-1"></i> Lista de Menús
        </h6>
    </div>
    <div class="card-body pt-1">
        <div class="row" style="display:none;">
            <div class="col-sm-12">
                <button class="btn btn-success" id="btnNuevo"><i class="fas fa-plus"></i> Nuevo Menú</button>
                <button class="btn btn-info ml-1" id="btnSincronizar"><i class="fas fa-sync-alt"></i> Sincronizar Módulos</button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <table class="table-modern" id="tbdata" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Orden</th>
                            <th>Descripción</th>
                            <th>Menú Padre</th>
                            <th>Icono</th>
                            <th>Controlador</th>
                            <th>Página Acción</th>
                            <th>Estado</th>
                            <th>Visible</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear/Editar Menú -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-labelledby="modalDataLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header-premium bg-second-primary">
                <h5 class="modal-title m-0 font-weight-bold text-white" id="modalDataLabel"><i class="fas fa-bars text-warning mr-2"></i> Detalle Menú</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" id="txtId" value="0">
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label for="txtDescripcion" class="font-weight-bold">Descripción</label>
                            <input type="text" class="form-control form-control-sm" id="txtDescripcion">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label for="cboMenuPadre" class="font-weight-bold">Menú Padre</label>
                            <select class="form-control form-control-sm" id="cboMenuPadre"></select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label for="txtIcono" class="font-weight-bold">Icono</label>
                            <select class="form-control form-control-sm" id="txtIcono" style="width:100%;">
                                <option value="">-- Seleccione un Icono --</option>
                            </select>
                            <div class="mt-2 text-center">
                                <i id="iconoPreviewModal" class="" style="font-size: 1.5rem; color: #004A93;"></i>
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="txtControlador" class="font-weight-bold">Controlador</label>
                            <input type="text" class="form-control form-control-sm" id="txtControlador">
                        </div>
                        <div class="form-group col-md-6">
                            <label for="txtPaginaAccion" class="font-weight-bold">Página Acción</label>
                            <input type="text" class="form-control form-control-sm" id="txtPaginaAccion">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="txtOrden" class="font-weight-bold">Orden</label>
                            <input type="number" class="form-control form-control-sm" id="txtOrden" name="orden" value="0" min="0">
                        </div>
                        <div class="form-group col-md-6">
                            <label for="cboEstado" class="font-weight-bold">Estado</label>
                            <select class="form-control form-control-sm" id="cboEstado">
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="checkMostrarEnMenu">
                                <label class="custom-control-label font-weight-bold" for="checkMostrarEnMenu">Mostrar en Navegación</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary btn-sm rounded-pill" type="button" id="btnGuardar"><i class="fas fa-save mr-1"></i> Guardar</button>
                <button class="btn btn-danger btn-sm rounded-pill" type="button" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>
    <script src="~/vendor/select2/select2.min.js"></script>
    <script src="~/vendor/select2/es.min.js"></script>
    <script src="~/js/vistas/Menu_Index.js" asp-append-version="true"></script>
}
