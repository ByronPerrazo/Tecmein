@{
    ViewData["Title"] = "Empresas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="~/vendor/datatables/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="~/vendor/datatables/extensiones/css/buttons.dataTables.min.css">
    <link rel="stylesheet" href="~/css/styleGenerales.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/premium-design.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/modern-table.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/theme-overrides.css" asp-append-version="true">
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">
            <i class="fas fa-building text-warning mr-1"></i> Listado de Empresas
        </h6>
    </div>
    <div class="card-body pt-1">
        <div class="row" style="display:none;">
            <div class="col-sm-3">
                <button class="btn btn-success" id="btnNuevaEmpresa" data-toggle="modal">
                    <i class="fas fa-plus"></i> Nueva Empresa
                </button>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <table class="table-modern" id="tbdata" cellspacing="0" style="width:100%">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Nombre</th>
                            <th>Identificación</th>
                            <th>Correo</th>
                            <th>Dirección</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear/Editar Empresa -->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header-premium bg-second-primary">
                <h5 class="modal-title m-0 font-weight-bold text-white"><i class="fas fa-building text-warning mr-2"></i> Detalle Empresa</h5>
                <button class="close text-white" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" value="0" id="txtId">
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="txtIndentificacion" class="font-weight-bold">Número Identificación</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtIndentificacion" name="Numero Documento">
                        </div>
                        <div class="form-group col-md-6">
                            <label for="txtRazonSocial" class="font-weight-bold">Razón Social</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtRazonSocial" name="Razon Social">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-12">
                            <label for="txtDireccion" class="font-weight-bold">Dirección</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtDireccion" name="Direccion">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="txtCorreo" class="font-weight-bold">Correo</label>
                            <input type="email" class="form-control form-control-sm input-validar" id="txtCorreo" name="Correo">
                        </div>
                        <div class="form-group col-md-6">
                            <label for="txTelefono" class="font-weight-bold">Teléfono</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txTelefono" name="Telefono">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="cboEstado" class="font-weight-bold">Estado</label>
                            <select class="form-control form-control-sm" id="cboEstado">
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label for="txtCodigoOperador" class="font-weight-bold">Código Operador</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtCodigoOperador" name="Impuesto">
                        </div>
                    </div>
                    <div class="form-row align-items-center">
                        <div class="form-group col-md-6">
                            <label for="txtLogo" class="font-weight-bold">Logo</label>
                            <div class="custom-file">
                                <input type="file" class="custom-file-input" id="txtLogo">
                                <label class="custom-file-label" for="txtLogo">Seleccionar logo...</label>
                            </div>
                        </div>
                        <div class="form-group col-md-6 text-center">
                            <img id="imgLogo" style="max-height:100px; max-width:100%; border: 1px solid #ddd; padding: 5px;" src="" class="rounded" alt="Logo">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary btn-sm rounded-pill" type="button" id="btnGuardar"><i class="fas fa-save mr-1"></i> Guardar</button>
                <button class="btn btn-danger btn-sm rounded-pill" type="button" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap4.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.responsive.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/dataTables.buttons.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/jszip.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.html5.min.js"></script>
    <script src="~/vendor/datatables/extensiones/js/buttons.print.min.js"></script>
    <script src="~/js/vistas/Empresa_Index.js" asp-append-version="true"></script>
}
