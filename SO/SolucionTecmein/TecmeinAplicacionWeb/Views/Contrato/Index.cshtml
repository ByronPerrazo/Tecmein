@{
    ViewData["Title"] = "Contratos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <!-- Bootstrap Datepicker CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css">
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-second-primary">
        <h6 class="m-0 font-weight-bold text-white">Lista de Contratos</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-3">
                <button class="btn btn-success" id="btnNuevo"><i class="fas fa-file-signature"></i> Nuevo Contrato</button>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-12">
                <table id="tbContrato" class="table table-bordered" style="width:100%">
                    <thead>
                        <tr>
                            <th>Obra</th>
                            <th>Fecha Firma</th>
                            <th>Usuario Carga</th>
                            <th>Archivo</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modalContrato" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="card shadow-sm">
                <div class="card-header py-2 bg-second-primary">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-file-signature"></i> Detalle Contrato
                        <button class="close float-right" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true" class="text-white">×</span>
                        </button>
                    </h6>
                </div>
                <div class="card-body p-2">
                    <form id="formContrato">
                        <input type="hidden" id="txtIdContrato" value="0">
                        <div class="form-group">
                            <label for="cboCotizacion">Obra (Cotización)</label>
                            <select class="form-control form-control-sm" id="cboCotizacion"></select>
                        </div>
                        <div class="form-group">
                            <label for="txtFechaFirma">Fecha de Firma</label>
                            <div class="input-group date" data-provide="datepicker">
                                <input type="text" class="form-control form-control-sm" id="txtFechaFirma">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-th"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="fileContrato">Archivo PDF del Contrato</label>
                            <input type="file" class="form-control-file" id="fileContrato" accept="application/pdf">
                        </div>
                    </form>
                </div>
                <div class="card-body p-0 d-flex justify-content-end">
                    <button class="btn btn-primary btn-sm m-1 mr-2" type="button" id="btnGuardar">Guardar</button>
                    <button class="btn btn-danger btn-sm m-1" type="button" data-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <!-- Bootstrap Datepicker JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/locales/bootstrap-datepicker.es.min.js"></script>
    
    <script src="~/js/vistas/Contrato_Index.js"></script>
}
