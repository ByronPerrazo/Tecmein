<!--  Modal-->
<div class="modal fade" id="modalData" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header modal-header-premium bg-second-primary">
                <h5 class="modal-title m-0 font-weight-bold text-white"><i class="fas fa-tag text-warning mr-2"></i> Detalle Tipo Impuesto</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <input type="hidden" value="0" id="txtSecuencial">
                    <div class="form-row">
                        <div class="form-group col-sm-6">
                            <label for="txtNombre" class="font-weight-bold">Nombre</label>
                            <input type="text" class="form-control form-control-sm input-validar" id="txtNombre" name="Nombre">
                        </div>
                        <div class="form-group col-sm-6">
                            <label for="cboEsIva" class="font-weight-bold">Es IVA</label>
                            <select class="form-control form-control-sm" id="cboEsIva">
                                <option value="true">Sí</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-sm-6">
                            <label for="cboEsImportacion" class="font-weight-bold">Es Importación</label>
                            <select class="form-control form-control-sm" id="cboEsImportacion">
                                <option value="true">Sí</option>
                                <option value="false">No</option>
                            </select>
                        </div>
                        <div class="form-group col-sm-6">
                            <label for="cboEstaActivo" class="font-weight-bold">Estado</label>
                            <select class="form-control form-control-sm" id="cboEstaActivo">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary btn-sm rounded-pill" type="button" id="btnGuardar"><i class="fas fa-save mr-1"></i> Guardar</button>
                <button class="btn btn-danger btn-sm rounded-pill" type="button" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>